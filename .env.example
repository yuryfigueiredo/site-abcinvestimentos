# Google Gemini AI Key
# Obtenha sua chave no Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_aqui
PUBLIC_GEMINI_API_KEY=sua_chave_aqui

# Google Analytics 4 (GA4) ID de Métrica (ex: G-XXXXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=

# Turso (somente no servidor/Cloudflare; nunca use PUBLIC_ nestas variáveis)
# URL HTTPS ou libsql:// da base criada no Turso
TURSO_DATABASE_URL=
# Token criado em Turso > Database > Settings > Tokens
TURSO_AUTH_TOKEN=

# OpenRouter (fallback de IA; somente no servidor/Vercel)
OPENROUTER_API_KEY=
# Opcional; por padrão usa o roteador gratuito do OpenRouter
OPENROUTER_MODEL=openrouter/free
