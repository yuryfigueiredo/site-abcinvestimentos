  .book-cover-initials {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.3rem;
    color: rgba(255, 255, 255, 0.94);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
    letter-spacing: 0.03em;
  }

  .book-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .book-badge {
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--pill-text);
    background: var(--pill-bg);
    border: 1px solid var(--pill-border);
    padding: 0.18rem 0.55rem;
    border-radius: 9999px;
    width: fit-content;
    margin-bottom: 0.6rem;
  }

  .book-title {
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.2rem;
    letter-spacing: -0.01em;
  }

  .book-author {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.65rem;
    display: block;
  }

  .book-summary {
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .book-btn {
    width: 100%;
    font-size: 0.84rem;
    margin-top: auto;
  }

  /* Disclaimer Panel */
  .disclaimer-panel {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 1.25rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.6;
    text-align: center;
  }

  .disclaimer-panel strong {
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .catalog-card,
    .level-card,
    .book-card {
      padding: 1.15rem 1rem;
    }
    .book-card {
      gap: 0.9rem;
    }
    .book-cover {
      flex: 0 0 88px;
      width: 88px;
    }
    .flagship-card {
      padding: 1.25rem 1rem;
    }
    .catalog-card-body p,
    .book-summary {
      font-size: 0.88rem;
      line-height: 1.55;
    }
  }
</style>
