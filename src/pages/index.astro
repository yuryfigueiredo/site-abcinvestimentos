---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroIA from '../components/HeroIA.astro';
import FinanceIcon from '../components/icons/FinanceIcon.astro';
import { CALCULATORS } from '../data/calculators';
import { GUIDES, GLOSSARY_TERMS } from '../data/guides';
import { SITE_CONFIG } from '../config/site';

const COVER_GRADIENTS: Record<string, string> = {
  'psicologia-financeira': 'linear-gradient(135deg, #0f766e, #134e4a)',
  'investidor-bom-senso': 'linear-gradient(135deg, #1d4ed8, #1e3a8a)',
  'rei-dos-dividendos': 'linear-gradient(135deg, #b45309, #78350f)',
  'faca-fortuna-acoes': 'linear-gradient(135deg, #7c3aed, #4c1d95)',
  'homem-mais-rico-babilonia': 'linear-gradient(135deg, #c2410c, #7c2d12)',
  'investidor-inteligente': 'linear-gradient(135deg, #0e7490, #155e75)',
};

const STOP_WORDS = ['com', 'para', 'que', 'por', 'dos', 'das', 'de', 'do', 'da', 'e', 'o', 'a', 'um', 'uma', 'os', 'as'];

// Capas em pt-BR sem imagem no Open Library: usa a edição original do mesmo livro
const OPEN_LIBRARY_QUERY_OVERRIDES: Record<string, string> = {
  'investidor-bom-senso': 'The Little Book of Common Sense Investing John Bogle',
};

function bookInitials(title: string): string {
  return title
    .split(' ')
    .filter((word) => word.length > 2 && !STOP_WORDS.includes(word.toLowerCase()))
    .slice(0, 2)
    .map((word) => word[0])
    .join('')
    .toUpperCase();
}

async function fetchJsonWithTimeout(url: string, timeoutMs = 4500): Promise<unknown | null> {
  try {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), timeoutMs);
    const res = await fetch(url, { signal: controller.signal });
    clearTimeout(timeout);
    if (!res.ok) return null;
    return await res.json();
  } catch {
    return null;
  }
}

async function fetchBookCovers(): Promise<Record<string, string>> {
  const covers: Record<string, string> = {};
  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  async function jsonOrRetry(url: string): Promise<unknown | null> {
    const first = await fetchJsonWithTimeout(url, 5000);
    if (first !== null) return first;
    await sleep(400);
    return fetchJsonWithTimeout(url, 5000);
  }

  // Sequencial de propósito: as APIs públicas (Google Books/Open Library) limitam rajadas paralelas
  for (const book of SITE_CONFIG.books) {
    const query = encodeURIComponent(`${book.title} ${book.author}`);

    const gbooks = (await jsonOrRetry(
      `https://www.googleapis.com/books/v1/volumes?q=${query}&langRestrict=pt&printType=books&maxResults=3`
    )) as { items?: { volumeInfo?: { imageLinks?: { thumbnail?: string } } }[] } | null;
    const thumb = gbooks?.items
      ?.map((item) => item.volumeInfo?.imageLinks?.thumbnail)
      .find(Boolean);
    if (thumb) {
      covers[book.id] = thumb.replace('http://', 'https://').replace('&zoom=1', '&zoom=2');
      continue;
    }

    const openLibQuery = OPEN_LIBRARY_QUERY_OVERRIDES[book.id] ?? query;
    const openLib = (await jsonOrRetry(
      `https://openlibrary.org/search.json?q=${openLibQuery}&fields=cover_i&limit=5`
    )) as { docs?: { cover_i?: number }[] } | null;
    const coverId = openLib?.docs?.find((doc) => doc.cover_i)?.cover_i;
    if (coverId) covers[book.id] = `https://covers.openlibrary.org/b/id/${coverId}-M.jpg`;
  }
  return covers;
}

const bookCovers = await fetchBookCovers();
---

<BaseLayout>
  <!-- 1. Hero Principal: Consultor IA + 4 Ferramentas + Métricas (Estilo Mais Retorno) -->
  <HeroIA />

  <!-- 2. Catálogo de Todas as Ferramentas Gratuitas -->
  <section class="section" id="ferramentas">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="badge-pill">Todas as Ferramentas</span>
          <h2>Simuladores Financeiros Gratuitos</h2>
          <p>Ferramentas matemáticas para você tomar as melhores decisões com o seu dinheiro.</p>
        </div>
      </div>

      <div class="tools-catalog-grid">
        {CALCULATORS.map((calc) => (
          <a href={`/calculadoras/${calc.slug}`} class="catalog-card">
            <div class="catalog-card-top">
              <span class="catalog-icon" aria-hidden="true">
                <FinanceIcon name={calc.icon} size={24} />
              </span>
              <span class="catalog-badge">{calc.badge}</span>
            </div>
            <div class="catalog-card-body">
              <h3>{calc.title}</h3>
              <p>{calc.subtitle}</p>
            </div>
            <div class="catalog-card-footer">
              <span class="catalog-link-text">Acessar simulador</span>
              <span class="catalog-arrow" aria-hidden="true">
                <FinanceIcon name="arrow-right" size={16} />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Destaque Especial: Planilha Oficial ABC 50/30/20 -->
  <section class="section" id="planilha">
    <div class="container">
      <div class="flagship-card">
        <a href="/planilha-abc" class="flagship-cover" aria-label="Conhecer a Planilha Oficial ABC">
          <img
            src="/capa-kiwify-planilha-abc.jpg"
            alt="Capa da Planilha ABC — Controle Financeiro 50/30/20 & Rumo ao 1º Milhão"
            width="1200"
            height="896"
            loading="lazy"
            decoding="async"
          />
        </a>
        <div class="flagship-content">
          <div class="flagship-pill">Kit Oficial de Organização Financeira</div>
          <h2 class="flagship-title">Planilha ABC — Controle 50/30/20 & Rumo ao 1º Milhão</h2>
          <p class="flagship-desc">
            8 abas automatizadas em Excel e Google Sheets. Do controle do orçamento diário ao cálculo da Reserva de Emergência e projeção do seu patrimônio com inflação real (sem macros VBA).
          </p>

          <div class="flagship-features-grid">
            <div class="feature-item">
              <span class="feature-check"><FinanceIcon name="check" size={16} /></span>
              <span>Regra 50/30/20 com alertas visuais</span>
            </div>
            <div class="feature-item">
              <span class="feature-check"><FinanceIcon name="check" size={16} /></span>
              <span>Reserva de Emergência por perfil</span>
            </div>
            <div class="feature-item">
              <span class="feature-check"><FinanceIcon name="check" size={16} /></span>
              <span>Visão anual de 12 meses consolidada</span>
            </div>
            <div class="feature-item">
              <span class="feature-check"><FinanceIcon name="check" size={16} /></span>
              <span>Projeção de 30 anos rumo ao R$ 1 Milhão</span>
            </div>
          </div>

          <div class="flagship-cta-row">
            <a href="/planilha-abc" class="btn btn-primary" style="padding: 0.85rem 1.6rem;">
              Conhecer a Planilha por R$ {SITE_CONFIG.product.priceLaunch.toFixed(2).replace('.', ',')} →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Trilha Educativa: O ABC do Investidor (Do A ao C) -->
  <section class="section" id="trilha-abc">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="badge-pill">Educação Financeira</span>
          <h2>A Trilha do Investidor: Do Bê-á-bá à Renda Passiva</h2>
          <p>Guias práticos e diretos ao ponto sem jargões desnecessários.</p>
        </div>
        <a href="/guia" class="btn btn-secondary">Ver Guia Completo & Dicionário →</a>
      </div>

      <div class="levels-grid">
        {(['A', 'B', 'C'] as const).map((lvl) => {
          const levelGuides = GUIDES.filter((g) => g.level === lvl);
          const titles = {
            A: 'Passo A — Reserva & Poupança',
            B: 'Passo B — Renda Fixa & Inflação',
            C: 'Passo C — Dividendos & FIIs',
          };
          return (
            <div class="level-card">
              <div class="level-card-head">
                <span class="level-tag">Nível {lvl}</span>
                <h3>{titles[lvl]}</h3>
              </div>
              <div class="level-guides-stack">
                {levelGuides.map((g) => (
                  <a href={`/guia/${g.slug}`} class="guide-item">
                    <span class="guide-time">{g.readTime}</span>
                    <strong class="guide-title">{g.title}</strong>
                    <p class="guide-summary">{g.summary}</p>
                    <span class="guide-link">Ler artigo →</span>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 5. Biblioteca do Investidor (Livros Clássicos de Finanças) -->
  <section class="section" id="livros">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="badge-pill">Leituras Recomendadas</span>
          <h2>Biblioteca do Investidor</h2>
          <p>Os 6 livros indispensáveis para formar mentalidade e estratégia sólida.</p>
        </div>
      </div>

      <div class="books-grid">
        {SITE_CONFIG.books.map((book) => (
          <div class="book-card">
            <div
              class:list={['book-cover', !bookCovers[book.id] && 'book-cover--fallback']}
              style={`background: ${COVER_GRADIENTS[book.id] ?? 'linear-gradient(135deg, #334155, #0f172a)'};`}
              aria-hidden="true"
            >
              <span class="book-cover-initials">{bookInitials(book.title)}</span>
              {bookCovers[book.id] && (
                <img
                  src={bookCovers[book.id]}
                  alt={`Capa do livro ${book.title}`}
                  loading="lazy"
                  decoding="async"
                  onerror="this.remove()"
                />
              )}
            </div>
            <div class="book-info">
              <span class="book-badge">{book.badge}</span>
              <h3 class="book-title">{book.title}</h3>
              <span class="book-author">por {book.author}</span>
              <p class="book-summary">{book.summary}</p>
              <a
                href={book.amazonUrl}
                target="_blank"
                rel="noopener noreferrer sponsored"
                class="btn btn-outline book-btn"
              >
                Ver na Amazon Brasil ↗
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Conformidade Legal & Ausência de Vínculo -->
  <section class="section" style="padding-top: 1rem; padding-bottom: 3.5rem;">
    <div class="container">
      <div class="disclaimer-panel">
        <p>
          <strong>Aviso Legal & Transparência:</strong> {SITE_CONFIG.legalDisclaimer} Todas as simulações e ferramentas possuem finalidade estritamente didática e educativa.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Tools Catalog Grid */
  .tools-catalog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .tools-catalog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .tools-catalog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .catalog-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    backdrop-filter: blur(8px);
    box-shadow: var(--card-shadow);
    text-decoration: none;
    min-height: 196px;
  }

  .catalog-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-hover);
    background: var(--glass-elevated);
  }

  .catalog-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .catalog-icon {
    color: var(--brand-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: var(--pill-bg);
    border: 1px solid var(--pill-border);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .catalog-card:hover .catalog-icon {
    color: var(--brand-blue);
    border-color: var(--brand-blue);
  }

  .catalog-badge {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--pill-text);
    background: var(--pill-bg);
    border: 1px solid var(--pill-border);
    padding: 0.18rem 0.55rem;
    border-radius: 9999px;
  }

  .catalog-card-body h3 {
    font-size: 1.06rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .catalog-card-body p {
    font-size: 0.86rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .catalog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.25rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.83rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 0.15s ease;
  }

  .catalog-card:hover .catalog-card-footer {
    color: var(--text-primary);
  }

  .catalog-arrow {
    color: var(--text-muted);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .catalog-card:hover .catalog-arrow {
    color: var(--brand-blue);
    transform: translateX(4px);
  }

  /* Flagship Planilha Card */
  .flagship-card {
    background: var(--glass-elevated);
    border: 1px solid var(--border-card);
    border-radius: 16px;
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    box-shadow: var(--card-shadow);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    align-items: center;
  }

  .flagship-cover {
    display: block;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-card);
    box-shadow: 0 14px 34px -12px rgba(0, 0, 0, 0.55);
    line-height: 0;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    max-width: 420px;
    margin-inline: auto;
  }

  .flagship-cover:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 42px -12px rgba(56, 189, 248, 0.35);
  }

  .flagship-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (min-width: 900px) {
    .flagship-card {
      grid-template-columns: 320px 1fr;
      gap: 2.5rem;
    }
    .flagship-cover {
      margin-inline: 0;
      max-width: none;
    }
  }

  .flagship-pill {
    display: inline-block;
    background: var(--pill-bg);
    border: 1px solid var(--pill-border);
    color: var(--pill-text);
    font-size: 0.74rem;
    font-weight: 500;
    padding: 0.22rem 0.7rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
  }

  .flagship-title {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    letter-spacing: -0.025em;
  }

  .flagship-desc {
    font-size: 0.96rem;
    color: var(--text-secondary);
    max-width: 720px;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .flagship-features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .feature-check {
    color: var(--brand-blue);
    display: inline-flex;
  }

  .flagship-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  /* Levels Grid */
  .levels-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 900px) {
    .levels-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .level-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: var(--card-shadow);
  }

  .level-card-head {
    margin-bottom: 1.15rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .level-tag {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .level-card-head h3 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 0.25rem;
  }

  .level-guides-stack {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .guide-item {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 1.05rem;
    display: block;
    text-decoration: none;
    transition: all 0.18s ease;
  }

  .guide-item:hover {
    border-color: var(--border-hover);
  }

  .guide-time {
    font-size: 0.76rem;
    color: var(--text-muted);
    display: block;
    margin-bottom: 0.25rem;
  }

  .guide-title {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text-primary);
    display: block;
    margin-bottom: 0.35rem;
    line-height: 1.38;
  }

  .guide-summary {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 0.65rem;
  }

  .guide-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--brand-blue);
    transition: color 0.15s ease;
  }

  .guide-item:hover .guide-link {
    color: var(--brand-blue);
  }

  /* Books Grid */
  .books-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 720px) {
    .books-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .books-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .book-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 1.15rem;
    box-shadow: var(--card-shadow);
    transition: transform 0.22s ease, border-color 0.22s ease, background 0.22s ease, box-shadow 0.22s ease;
  }

  .book-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-hover);
    background: var(--glass-elevated);
  }

  .book-cover {
    flex: 0 0 100px;
    width: 100px;
    aspect-ratio: 2 / 3;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    border: 1px solid var(--border-card);
    box-shadow: 0 10px 22px -10px rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    isolation: isolate;
  }

  .book-cover--fallback::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0.18), transparent 42%),
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 14px);
    z-index: -1;
  }

  .book-cover--fallback::after {
    content: '';
    position: absolute;
    inset: 7px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 4px;
    pointer-events: none;
  }

  .book-cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
