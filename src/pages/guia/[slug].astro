---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import { GUIDES, SITE_PUBLISHED_AT, type GuideArticle } from '../../data/guides';
import { SITE_CONFIG } from '../../config/site';

export function getStaticPaths() {
  return GUIDES.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: GuideArticle;
}

const { guide } = Astro.props;

const publishedAt = guide.datePublished ?? SITE_PUBLISHED_AT;
const modifiedAt = guide.dateModified ?? publishedAt;
const publishedLabel = new Date(`${publishedAt}T12:00:00`).toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
});
const modifiedLabel = new Date(`${modifiedAt}T12:00:00`).toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
});
// Show "Atualizado em" only when dateModified differs from datePublished
const showModifiedDate = guide.dateModified && guide.dateModified !== publishedAt;
const articleUrl = new URL(Astro.url.pathname, SITE_CONFIG.url).toString();

// Related articles: same level, excluding current article, up to 3
const relatedArticles = GUIDES
  .filter((g) => g.level === guide.level && g.slug !== guide.slug)
  .slice(0, 3);

const guideJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: guide.title,
      description: guide.summary,
      image: [new URL('/og-image.png', SITE_CONFIG.url).toString()],
      datePublished: publishedAt,
      dateModified: modifiedAt,
      isAccessibleForFree: true,
      inLanguage: 'pt-BR',
      author: {
        '@type': 'Person',
        name: SITE_CONFIG.author,
        url: `${SITE_CONFIG.url}/sobre`,
        jobTitle: 'Educador Financeiro',
        knowsAbout: ['Renda Fixa', 'Fundos Imobiliários', 'Ações', 'Juros Compostos', 'Educação Financeira'],
      },
      editor: guide.editor
        ? {
            '@type': 'Person',
            name: guide.editor,
            url: `${SITE_CONFIG.url}/sobre`,
          }
        : undefined,
      publisher: { '@id': `${SITE_CONFIG.url}/#organization` },
      isPartOf: { '@type': 'WebSite', '@id': `${SITE_CONFIG.url}/#website` },
      mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: SITE_CONFIG.url },
        { '@type': 'ListItem', position: 2, name: 'Guia ABC', item: `${SITE_CONFIG.url}/guia` },
        { '@type': 'ListItem', position: 3, name: guide.title },
      ],
    },
  ],
};
---

<BaseLayout title={`${guide.title} | ABC`} description={guide.summary}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(guideJsonLd)} />
  <article class="guide-post-section">
    <div class="container guide-container">
      <nav class="breadcrumb" aria-label="Navegação estrutural">
        <a href="/">Início</a> <span>/</span> <a href="/guia">Guia ABC</a> <span>/</span> <strong>{guide.title}</strong>
      </nav>

      <header class="post-header">
        <div class="post-meta">
          <span class="badge-pill">{guide.levelTitle}</span>
          <span class="post-read">{guide.readTime}</span>
        </div>
        <h1>{guide.title}</h1>
        <p class="post-lead">{guide.subtitle}</p>
        <p class="post-byline">
          Por <a href="/sobre">{SITE_CONFIG.author}</a>
          {guide.editor && <span class="badge-editor-verified">✓ Verificado por {guide.editor}</span>}
          {showModifiedDate ? (
            <time datetime={modifiedAt}>Atualizado em {modifiedLabel}</time>
          ) : (
            <time datetime={publishedAt}>Publicado em {publishedLabel}</time>
          )}
        </p>
      </header>

      <div class="post-body abc-card">
        {guide.sections.map((sec) => (
          <section class="post-block">
            <h2>{sec.heading}</h2>
            {sec.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
            {sec.bullets && (
              <ul class="post-bullets">
                {sec.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
            {sec.highlightBox && (
              <div class="post-highlight">
                <strong>Ponto-Chave:</strong> {sec.highlightBox}
              </div>
            )}
          </section>
        ))}

        <!-- Expert tip callout (E-E-A-T signal) -->
        <div class="post-expert-tip">
          <strong>💡 Dica:</strong> Use nossas calculadoras gratuitas para aplicar os conceitos deste guia na prática.
          Todos os simuladores usam dados oficiais do Banco Central.
        </div>

        <div class="post-tool-cta">
          <div>
            <span class="badge-pill">Simulador Prático</span>
            <h3>Simule os números deste guia na nossa calculadora gratuita</h3>
            <p>Sem cadastro: ajuste os controles deslizantes e veja o resultado em tempo real.</p>
          </div>
          <a href={`/calculadoras/${guide.relatedCalculatorSlug}`} class="btn btn-primary">
            {guide.relatedCalculatorLabel} →
          </a>
        </div>
      </div>

      <AdSlot slotId="guide-article-bottom" />

      <!-- Recomendação Discreta da Planilha Oficial no Fim do Guia -->
      <aside class="abc-card post-sheet-box">
        <div>
          <span class="badge-pill">Organização Prática no Excel & Google Sheets</span>
          <h3>{SITE_CONFIG.product.title}</h3>
          <p>{SITE_CONFIG.product.subtitle}</p>
        </div>
        <a href="/planilha-abc" class="btn btn-secondary">Conhecer a Planilha Oficial →</a>
      </aside>

      <!-- Related articles from the same level (E-E-A-T internal linking) -->
      {relatedArticles.length > 0 && (
        <section class="post-related-articles">
          <h2>Leia também</h2>
          <div class="related-grid">
            {relatedArticles.map((related) => (
              <a href={`/guia/${related.slug}`} class="related-card">
                <span class="badge-pill">{related.levelTitle}</span>
                <h3>{related.title}</h3>
                <span class="related-read-time">{related.readTime}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .guide-post-section {
    padding-block: 2.25rem 3.5rem;
  }

  .guide-container {
    max-inline-size: 860px;
  }

  .breadcrumb {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-block-end: 1.2rem;
    display: flex;
    gap: 0.45rem;
  }

  .breadcrumb a {
    white-space: nowrap;
  }

  .post-header {
    margin-block-end: 1.75rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-block-end: 0.75rem;
  }

  .post-read {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .post-header h1 {
    font-size: clamp(1.75rem, 3.2vw, 2.4rem);
    margin-block-end: 0.6rem;
  }

  .post-lead {
    margin: 0;
    font-size: 1.08rem;
    color: var(--text-secondary);
  }

  .post-byline {
    margin: 0.85rem 0 0;
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .post-byline a {
    color: var(--brand-blue);
    font-weight: 600;
    text-decoration: none;
  }

  .post-byline a:hover {
    text-decoration: underline;
  }

  /* Separator travels with the date so it never strands at the end of a wrapped line. */
  .post-byline time::before {
    content: "·";
    margin-inline-end: 0.4rem;
    color: var(--text-muted);
  }

  .post-body {
    padding: 2rem;
  }

  .post-block {
    margin-block-end: 2rem;
  }

  .post-block h2 {
    font-size: 1.3rem;
    margin-block-end: 0.75rem;
  }

  .post-block p {
    font-size: 1rem;
    color: var(--text-secondary);
    margin-block: 0 0.9rem;
  }

  .post-bullets {
    padding-inline-start: 1.25rem;
    color: var(--text-primary);
    display: grid;
    gap: 0.5rem;
    margin-block: 0.75rem 1rem;
  }

  .post-highlight {
    padding: 1rem 1.2rem;
    border-radius: 0.8rem;
    background: color-mix(in oklab, var(--brand-emerald) 12%, var(--bg-elevated));
    border-inline-start: 4px solid var(--brand-emerald);
    font-size: 0.94rem;
  }

  .post-tool-cta {
    margin-block-start: 2rem;
    padding: 1.4rem;
    border-radius: 0.95rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .post-tool-cta h3 {
    margin: 0.4rem 0 0.25rem;
    font-size: 1.1rem;
  }

  .post-tool-cta p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .post-sheet-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .post-sheet-box h3 {
    margin: 0.4rem 0 0.25rem;
    font-size: 1.12rem;
  }

  .post-sheet-box p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  /* Editor verification badge (E-E-A-T signal) */
  .badge-editor-verified {
    display: inline-block;
    margin-inline-start: 0.5rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--brand-emerald);
    background: color-mix(in oklab, var(--brand-emerald) 12%, transparent);
    border: 1px solid color-mix(in oklab, var(--brand-emerald) 25%, transparent);
    vertical-align: middle;
  }

  /* Expert tip callout */
  .post-expert-tip {
    margin-block: 1.5rem 2rem;
    padding: 1rem 1.2rem;
    border-radius: 0.8rem;
    background: color-mix(in oklab, var(--brand-blue) 8%, var(--bg-elevated));
    border-inline-start: 4px solid var(--brand-blue);
    font-size: 0.94rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .post-expert-tip strong {
    color: var(--text-primary);
  }

  /* Related articles section */
  .post-related-articles {
    margin-block-start: 2.5rem;
  }

  .post-related-articles h2 {
    font-size: 1.3rem;
    margin-block-end: 1.25rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .related-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.2rem;
    border-radius: 0.85rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .related-card:hover {
    border-color: var(--brand-blue);
    box-shadow: 0 2px 12px rgba(2, 132, 199, 0.08);
  }

  .related-card h3 {
    font-size: 0.95rem;
    margin: 0;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .related-read-time {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 600;
  }
</style>
