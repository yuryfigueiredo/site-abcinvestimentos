---
import { type GetStaticPathsResult, type GetStaticPathsResultKey } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JsonLdBreadcrumb from '../../../components/JsonLdBreadcrumb.astro';
import Byline from '../../../components/Byline.astro';
import { PRODUCTS, AMOUNTS, calculateReturns, type QuantoRendeProduct, type QuantoRendeAmount } from '../../../data/quanto-rende';
import { getIndicators, poupancaReferenceText } from '../../../lib/indicators';
import { formatBRL, formatPct, formatDateBr } from '../../../lib/finance';

export async function getStaticPaths(): Promise<GetStaticPathsResult> {
  const paths: GetStaticPathsResultKey[] = [];
  
  for (const product of PRODUCTS) {
    for (const amount of AMOUNTS) {
      paths.push({
        params: { produto: product.slug, valor: amount.slug },
        props: { product, amount },
      });
    }
  }
  
  return paths;
}

const { product, amount } = Astro.props as { product: QuantoRendeProduct; amount: QuantoRendeAmount };

const indicators = await getIndicators();
const PERIODS = [1, 6, 12, 24];
const results = PERIODS.map((months) => calculateReturns(amount.value, product, indicators, months));

// Poupança não se compara com ela mesma: o rival vira um CDB de liquidez diária.
const isPoupanca = product.type === 'poupanca';
const rival = PRODUCTS.find((p) => p.slug === (isPoupanca ? 'cdb-100-cdi' : 'poupanca'))!;
const product12 = calculateReturns(amount.value, product, indicators, 12);
const rival12 = calculateReturns(amount.value, rival, indicators, 12);
const difference = product12.finalAmount - rival12.finalAmount;
const winner = difference >= 0 ? product : rival;

const canonicalUrl = `https://www.abcinvestimentos.com.br/quanto-rende/${product.slug}/${amount.slug}`;

// Resposta em 12 meses: é o que o buscador quer ler antes de clicar.
const net12 = product12.netReturn;
const net12Short = formatBRL(net12, 0);
const monthlyShort = formatBRL(net12 / 12, 0);
const differenceShort = formatBRL(Math.abs(difference), 0);

const TITLE_LIMIT = 60;
const DESC_LIMIT = 158;

// Encaixa o primeiro formato que não estoura o limite visível do Google.
const titleCandidates = [
  `Quanto Rende ${amount.displayText} em ${product.name}? ${net12Short} em 12 Meses`,
  `${amount.displayText} em ${product.name} Rende ${net12Short} em 12 Meses`,
  `Quanto Rende ${amount.displayText} em ${product.name}? (Taxas de Hoje)`,
  `Quanto Rende ${amount.displayText} em ${product.name}?`,
];
const pageTitle = titleCandidates.find((t) => t.length <= TITLE_LIMIT) ?? titleCandidates.at(-1)!;

// Selic e CDI sao medidos; o numero da Poupança vem de regra com TR de referência. As frases
// estruturadas não podem carimbar os dois juntos como "taxas do Banco Central" — e o JSON-LD é
// a primeira string que o Google lê, à frente da visível.
const ratesLead = isPoupanca ? poupancaReferenceText(indicators) : 'Com as taxas do Banco Central';
const ratesTail = isPoupanca
  ? `; Selic ${formatPct(indicators.selic)} e CDI ${formatPct(indicators.cdi)} medidos em ${indicators.updatedAt}`
  : ` de ${indicators.updatedAt} (Selic ${formatPct(indicators.selic)}, CDI ${formatPct(indicators.cdi)})`;

// Partes em ordem de valor para o clique: resposta, frescor, rival, profundidade.
const descriptionParts = [
  `${amount.displayText} em ${product.name} rende ${net12Short} líquido em 12 meses (${monthlyShort} por mês).`,
  isPoupanca ? `${poupancaReferenceText(indicators)}.` : `Taxas BCB de ${indicators.updatedAt}.`,
  winner === product
    ? `Supera ${rival.name} em ${differenceShort}.`
    : `${rival.name} rende ${differenceShort} a mais.`,
  'Tabela completa de 1, 6, 12 e 24 meses.',
];
const pageDescription = descriptionParts.reduce((acc, part) => {
  const candidate = acc ? `${acc} ${part}` : part;
  return candidate.length <= DESC_LIMIT ? candidate : acc;
}, '') || descriptionParts[0].slice(0, DESC_LIMIT);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `Quanto rende ${amount.displayText} em ${product.name}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${ratesLead}${ratesTail}, ${amount.displayText} em ${product.name} rendem ${formatBRL(results[0].netReturn)} em 1 mês, ${formatBRL(results[1].netReturn)} em 6 meses e ${formatBRL(results[2].netReturn)} em 12 meses, já líquidos${product.hasIR ? ' do Imposto de Renda' : ' (isento de Imposto de Renda)'}. O valor final em 12 meses é ${formatBRL(product12.finalAmount)}.`,
      },
    },
    {
      '@type': 'Question',
      name: `${product.name} é seguro?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: product.hasFGC 
          ? `Sim, ${product.name} conta com a proteção do FGC (Fundo Garantidor de Créditos) até R$ 250 mil por CPF e por instituição.`
          : `Sim, ${product.name} é um título público federal com risco soberano, considerado o investimento mais seguro do país.`,
      },
    },
    {
      '@type': 'Question',
      name: `Posso resgatar ${product.name} a qualquer momento?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: product.liquidity === 'daily'
          ? `Sim, ${product.name} possui liquidez diária, permitindo resgate no mesmo dia ou no dia útil seguinte.`
          : `${product.name} possui prazo fixo de vencimento. Resgates antecipados estão sujeitos à marcação a mercado.`,
      },
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <JsonLdBreadcrumb
    crumbs={[
      { name: 'Início', path: '/' },
      { name: 'Calculadoras', path: '/calculadoras' },
      { name: 'Quanto rende' },
    ]}
  />

  <div class="abc-container abc-py-8">
    <div class="abc-max-w-4xl abc-mx-auto">
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="abc-text-sm abc-text-gray-500 abc-mb-6">
        <ol class="abc-flex abc-gap-2">
          <li><a href="/" class="abc-text-abc-blue hover:abc-underline">Início</a></li>
          <li aria-hidden="true">›</li>
          <li><a href="/calculadoras" class="abc-text-abc-blue hover:abc-underline">Calculadoras</a></li>
          <li aria-hidden="true">›</li>
          <li class="abc-text-gray-700">Quanto rende</li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="abc-mb-8">
        <h1 class="abc-text-3xl md:abc-text-4xl abc-font-bold abc-text-gray-900 abc-mb-4">
          Quanto rende {amount.displayText} em {product.name}
        </h1>
        <p class="abc-text-lg abc-text-gray-600">
          {isPoupanca ? 'Simulação com a regra oficial da poupança, sobre Selic e CDI medidos pelo Banco Central' : 'Simulação com taxas atualizadas do Banco Central do Brasil'}
        </p>
        <Byline updatedAt={indicators.updatedAt} sourceLabel={isPoupanca ? 'Selic e CDI medidos no Banco Central' : 'taxas do Banco Central'} />
        <p class="abc-text-lg abc-font-semibold abc-text-gray-900 abc-mt-4">
          Resposta direta: em 12 meses, {amount.displayText} em {product.name} rendem
          {formatBRL(net12)} líquidos ({formatBRL(net12 / 12)} por mês), totalizando
          {formatBRL(product12.finalAmount)}.
        </p>
      </header>

      <!-- Main Content -->
      <article class="abc-prose abc-max-w-none">
        <section class="abc-mb-8">
          <p class="abc-text-lg abc-leading-relaxed">
            {product.contextualText}
          </p>
        </section>

        <!-- Live Rates Banner -->
        <div class="abc-bg-blue-50 abc-border abc-border-blue-200 abc-rounded-lg abc-p-6 abc-mb-8">
          <h2 class="abc-text-xl abc-font-semibold abc-text-gray-900 abc-mb-4">
            Taxas utilizadas nesta simulação
          </h2>
          <div id="rate-display" class="abc-grid abc-grid-cols-2 md:abc-grid-cols-4 abc-gap-4">
            <div class="abc-text-center">
              <div class="abc-text-sm abc-text-gray-600">Selic</div>
              <div class="abc-text-2xl abc-font-bold abc-text-abc-blue" id="selic-rate">{formatPct(indicators.selic)}</div>
              <div class="abc-text-xs abc-text-gray-500">ao ano</div>
            </div>
            <div class="abc-text-center">
              <div class="abc-text-sm abc-text-gray-600">CDI</div>
              <div class="abc-text-2xl abc-font-bold abc-text-abc-blue" id="cdi-rate">{formatPct(indicators.cdi)}</div>
              <div class="abc-text-xs abc-text-gray-500">ao ano</div>
            </div>
            <div class="abc-text-center">
              <div class="abc-text-sm abc-text-gray-600">IPCA</div>
              <div class="abc-text-2xl abc-font-bold abc-text-abc-blue" id="ipca-rate">{formatPct(indicators.ipca12m)}</div>
              <div class="abc-text-xs abc-text-gray-500">ao ano</div>
            </div>
            <div class="abc-text-center">
              <div class="abc-text-sm abc-text-gray-600">Atualizado</div>
              <div class="abc-text-sm abc-text-gray-700" id="rate-date">{formatDateBr(indicators.updatedAt)}</div>
              <div class="abc-text-xs abc-text-gray-500">Banco Central</div>
            </div>
          </div>
        </div>

        <!-- Results Table -->
        <section class="abc-mb-8">
          <h2 class="abc-text-2xl abc-font-bold abc-text-gray-900 abc-mb-4">
            Quanto rende {amount.displayText} em {product.name}?
          </h2>
          <div class="abc-overflow-x-auto">
            <table class="abc-table abc-w-full abc-text-left" id="results-table">
              <thead class="abc-bg-gray-100">
                <tr>
                  <th class="abc-px-4 abc-py-3 abc-font-semibold">Prazo</th>
                  <th class="abc-px-4 abc-py-3 abc-font-semibold">Rendimento Bruto</th>
                  <th class="abc-px-4 abc-py-3 abc-font-semibold">Rendimento Líquido</th>
                  <th class="abc-px-4 abc-py-3 abc-font-semibold">Valor Final</th>
                </tr>
              </thead>
              <tbody id="results-body">
                {results.map((result) => (
                  <tr class="abc-border-t">
                    <td class="abc-px-4 abc-py-3 abc-font-medium">{result.label}</td>
                    <td class="abc-px-4 abc-py-3">{formatBRL(result.grossReturn)}</td>
                    <td class="abc-px-4 abc-py-3 abc-font-semibold">{formatBRL(result.netReturn)}</td>
                    <td class="abc-px-4 abc-py-3 abc-text-green-600 abc-font-bold">{formatBRL(result.finalAmount)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {isPoupanca && (
            <p class="abc-text-sm abc-text-gray-600 abc-mt-2">
              {poupancaReferenceText(indicators)} — por isso o valor não é lido diretamente de uma série do BCB.
            </p>
          )}
          {product.hasIR && (
            <p class="abc-text-sm abc-text-gray-600 abc-mt-2">
              * Valores líquidos já descontam o Imposto de Renda conforme tabela regressiva.
            </p>
          )}
          {!product.hasIR && (
            <p class="abc-text-sm abc-text-gray-600 abc-mt-2">
              * {product.name} é isento de Imposto de Renda para pessoa física.
            </p>
          )}
        </section>

        <!-- Comparison -->
        <section class="abc-bg-green-50 abc-border abc-border-green-200 abc-rounded-lg abc-p-6 abc-mb-8">
          <h2 class="abc-text-xl abc-font-semibold abc-text-gray-900 abc-mb-4">
            Comparação com {rival.name}
          </h2>
          <p class="abc-text-gray-700 abc-mb-4">
            Em 12 meses, {amount.displayText} em {winner.name} rendem {formatBRL(Math.abs(difference))} a mais que em {winner === product ? rival.name : product.name}.
          </p>
          <div class="abc-grid md:abc-grid-cols-2 abc-gap-4">
            <div class="abc-bg-white abc-rounded-lg abc-p-4 abc-text-center">
              <div class="abc-text-sm abc-text-gray-600 abc-mb-1">Em {product.name} (12 meses)</div>
              <div class="abc-text-2xl abc-font-bold abc-text-gray-700" id="product-12m">{formatBRL(product12.finalAmount)}</div>
            </div>
            <div class="abc-bg-white abc-rounded-lg abc-p-4 abc-text-center">
              <div class="abc-text-sm abc-text-gray-600 abc-mb-1">Em {rival.name} (12 meses)</div>
              <div class="abc-text-2xl abc-font-bold abc-text-green-600" id="rival-12m">{formatBRL(rival12.finalAmount)}</div>
            </div>
          </div>
          <div class="abc-mt-4 abc-text-center">
            <div class="abc-text-sm abc-text-gray-600">Diferença em 12 meses a favor de {winner.name}</div>
            <div class="abc-text-3xl abc-font-bold abc-text-green-600" id="difference-12m">{formatBRL(Math.abs(difference))}</div>
          </div>
        </section>

        <!-- Product Details -->
        <section class="abc-mb-8">
          <h2 class="abc-text-2xl abc-font-bold abc-text-gray-900 abc-mb-4">
            Sobre {product.name}
          </h2>
          <dl class="abc-space-y-3">
            <div class="abc-grid abc-grid-cols-2 abc-gap-4">
              <dt class="abc-font-semibold abc-text-gray-700">Segurança:</dt>
              <dd class="abc-text-gray-600">
                {product.hasFGC ? 'Protegido pelo FGC até R$ 250 mil' : 'Risco soberano (Tesouro Nacional)'}
              </dd>
            </div>
            <div class="abc-grid abc-grid-cols-2 abc-gap-4">
              <dt class="abc-font-semibold abc-text-gray-700">Liquidez:</dt>
              <dd class="abc-text-gray-600">
                {product.liquidity === 'daily' ? 'Diária (D+0 ou D+1)' : 'Prazo fixo até o vencimento'}
              </dd>
            </div>
            <div class="abc-grid abc-grid-cols-2 abc-gap-4">
              <dt class="abc-font-semibold abc-text-gray-700">Tributação:</dt>
              <dd class="abc-text-gray-600">
                {product.hasIR ? 'IR regressivo (22,5% a 15%)' : 'Isento de IR para pessoa física'}
              </dd>
            </div>
          </dl>
        </section>

        <!-- CTA -->
        <section class="abc-bg-abc-blue abc-text-white abc-rounded-lg abc-p-8 abc-text-center abc-mb-8">
          <h2 class="abc-text-2xl abc-font-bold abc-mb-4">
            Quer simular outros valores e produtos?
          </h2>
          <p class="abc-text-lg abc-mb-6 abc-opacity-90">
            Use nossas calculadoras gratuitas com as taxas do Banco Central
          </p>
          <div class="abc-flex abc-flex-wrap abc-gap-4 abc-justify-center">
            <a href="/calculadoras/renda-fixa" class="abc-bg-white abc-text-abc-blue abc-px-6 abc-py-3 abc-rounded-lg abc-font-semibold hover:abc-bg-gray-100 abc-transition">
              Comparador de Renda Fixa
            </a>
            <a href="/calculadoras/juros-compostos" class="abc-bg-white abc-text-abc-blue abc-px-6 abc-py-3 abc-rounded-lg abc-font-semibold hover:abc-bg-gray-100 abc-transition">
              Simulador de Juros Compostos
            </a>
          </div>
        </section>
      </article>

      <!-- Cross-value links (mesma série, outros aportes) -->
      <section class="abc-mt-12">
        <h2 class="abc-text-xl abc-font-bold abc-text-gray-900 abc-mb-4">
          Quanto rende em {product.name}: outros valores
        </h2>
        <div class="abc-grid sm:abc-grid-cols-2 lg:abc-grid-cols-4 abc-gap-4">
          {AMOUNTS.filter((a) => a.slug !== amount.slug).map((a) => (
            <a
              href={`/quanto-rende/${product.slug}/${a.slug}`}
              class="abc-block abc-bg-white abc-border abc-border-gray-200 abc-rounded-lg abc-p-4 hover:abc-border-abc-blue abc-transition"
            >
              <div class="abc-text-lg abc-font-semibold abc-text-gray-900">{a.displayText}</div>
              <div class="abc-text-sm abc-text-green-600 abc-font-semibold abc-mt-1">
                {formatBRL(calculateReturns(a.value, product, indicators, 12).netReturn, 0)} em 12 meses
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Cross-product links (mesmo aporte, outras séries) -->
      <section class="abc-mt-8">
        <h2 class="abc-text-xl abc-font-bold abc-text-gray-900 abc-mb-4">
          Compare {amount.displayText} em outros investimentos
        </h2>
        <div class="abc-grid sm:abc-grid-cols-2 lg:abc-grid-cols-3 abc-gap-4">
          {PRODUCTS.filter((p) => p.slug !== product.slug).map((p) => (
            <a
              href={`/quanto-rende/${p.slug}/${amount.slug}`}
              class="abc-block abc-bg-gray-50 abc-rounded-lg abc-p-4 hover:abc-bg-gray-100 abc-transition"
            >
              <div class="abc-font-semibold abc-text-gray-900 abc-mb-1">
                Quanto rende {amount.displayText} em {p.name}
              </div>
              <div class="abc-text-sm abc-text-abc-blue">Ver simulação →</div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>

</BaseLayout>
