---
import { formatDateBr } from '../../lib/finance';
import type { SourceRef } from '../../lib/diario/types';

interface Props {
  sources: SourceRef[];
}

const { sources } = Astro.props;
---

{sources.length > 0 && (
  <section class="source-list" aria-labelledby="fontes-da-edicao">
    <div class="source-list__heading">
      <span class="source-list__eyebrow">Proveniência</span>
      <h2 id="fontes-da-edicao">Fontes desta edição</h2>
    </div>
    <ul>
      {sources.map((source) => (
        <li>
          <a href={source.canonicalUrl} rel="noopener noreferrer">
            <span class="source-list__publisher">{source.publisher}</span>
            <strong>{source.title}</strong>
          </a>
          <p>
            {source.publishedAt && <time datetime={source.publishedAt}>{formatDateBr(source.publishedAt.slice(0, 10))}</time>}
            {source.author && <span> · {source.author}</span>}
            {source.licenseUrl && (
              <span> · <a href={source.licenseUrl} rel="license noopener noreferrer">Licença</a></span>
            )}
          </p>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .source-list {
    margin-block-start: 2rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--border-subtle);
  }

  .source-list__eyebrow {
    color: var(--brand-blue);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .source-list h2 {
    margin-block-start: 0.3rem;
    font-size: 1.1rem;
  }

  .source-list ul {
    display: grid;
    gap: 0.85rem;
    margin-block-start: 1rem;
    list-style: none;
  }

  .source-list li {
    padding: 0.9rem 1rem;
    border-inline-start: 2px solid var(--border-hover);
    background: var(--bg-surface);
  }

  .source-list li > a {
    display: grid;
    gap: 0.25rem;
    text-decoration: none;
  }

  .source-list li > a:hover strong {
    color: var(--brand-blue);
  }

  .source-list__publisher {
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .source-list li strong {
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .source-list li p {
    margin-block-start: 0.45rem;
    color: var(--text-muted);
    font-size: 0.74rem;
  }

  .source-list li p a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
