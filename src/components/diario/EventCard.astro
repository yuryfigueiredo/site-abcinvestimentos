---
import { formatDateBr } from '../../lib/finance';
import type { CalendarEvent } from '../../lib/diario/types';

interface Props {
  event: CalendarEvent;
}

const { event } = Astro.props;
---

<section class="event-card" aria-labelledby={`evento-${event.id}`}>
  <span class="event-card__eyebrow">Evento oficial</span>
  <h2 id={`evento-${event.id}`}>{event.title}</h2>
  <time datetime={event.date}>{formatDateBr(event.date)}</time>
  <a href={event.sourceUrl} rel="noopener noreferrer">Consultar fonte oficial →</a>
</section>

<style>
  .event-card {
    display: grid;
    gap: 0.75rem;
    margin-block-start: 2.75rem;
    padding-block-start: 1.75rem;
    border-block-start: 1px solid var(--border-subtle);
  }

  .event-card__eyebrow {
    color: var(--brand-blue);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .event-card h2 {
    font-size: 1.3rem;
    line-height: 1.35;
    text-wrap: balance;
  }

  .event-card time {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
  }

  .event-card a {
    justify-self: start;
    color: var(--brand-blue);
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.6;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .event-card a:focus-visible {
    border-radius: 2px;
    outline: 2px solid var(--brand-blue);
    outline-offset: 3px;
  }
</style>
