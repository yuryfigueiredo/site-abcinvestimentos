<div id="lgpd-banner" class="lgpd-banner" role="region" aria-label="Aviso de Privacidade e Cookies" hidden>
  <div class="lgpd-content">
    <p>
      <strong>Privacidade & Transparência (LGPD):</strong> O uso das conversas para treinar e melhorar a IA só acontece se você marcar a autorização no próprio campo do consultor. Não solicitamos CPF nem dados bancários. Consulte nossa <a href="/privacidade">Política de Privacidade</a>.
    </p>
    <button type="button" id="lgpd-accept-btn" class="btn-primary lgpd-btn">Entendi e Aceito</button>
  </div>
</div>

<script>
  const banner = document.getElementById('lgpd-banner');
  const acceptBtn = document.getElementById('lgpd-accept-btn');
  try {
    if (banner && !localStorage.getItem('abc_lgpd_accepted')) {
      banner.hidden = false;
    }
    acceptBtn?.addEventListener('click', () => {
      try {
        localStorage.setItem('abc_lgpd_accepted', '1');
      } catch {}
      if (banner) banner.hidden = true;
    });
  } catch {}
</script>

<style>
  .lgpd-banner {
    position: fixed;
    inset-block-end: 1rem;
    inset-inline: 1rem;
    max-inline-size: 780px;
    margin-inline: auto;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 0.9rem;
    padding: 0.9rem 1.25rem;
    box-shadow: 0 20px 45px -10px rgb(0 0 0 / 0.45);
    z-index: 45;
  }

  .lgpd-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .lgpd-content p {
    margin: 0;
    font-size: 0.82rem;
    color: var(--text-secondary);
    flex: 1 1 420px;
  }

  .lgpd-content a {
    color: var(--brand-blue);
    text-decoration: underline;
  }

  .lgpd-btn {
    padding: 0.55rem 1rem;
    font-size: 0.83rem;
  }
</style>
