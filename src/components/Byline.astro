---
import { SITE_CONFIG } from '../config/site';
import { formatDateBr } from '../lib/finance';

interface Props {
  /** Data ISO (YYYY-MM-DD) da série do Banco Central usada no cálculo exibido. */
  updatedAt?: string;
  /** O que a data cobre: taxas por padrão, data de verificação nos guias. */
  sourceLabel?: string;
}

const { updatedAt, sourceLabel = 'taxas do Banco Central' } = Astro.props;
// formatDateBr devolve o rótulo cru quando a fonte não é ISO — o fallback de taxa
// vem como 'Out/2026 (Referência BCB)' e um Date() aqui imprimia NaN/NaN/NaN.
const dateLabel = updatedAt && /^\d{4}-\d{2}-\d{2}$/.test(updatedAt) ? formatDateBr(updatedAt) : updatedAt ?? null;
---

<p class="abc-text-sm abc-text-gray-500 abc-mt-4">
  Por <a href="/sobre" class="abc-text-abc-blue hover:abc-underline abc-font-semibold">{SITE_CONFIG.author}</a>
  {dateLabel && (
    <> · <span class="abc-text-gray-600">{sourceLabel} de</span> <time datetime={updatedAt}>{dateLabel}</time></>
  )}
  {' · '}<a href="/sobre#metodologia" class="abc-text-abc-blue hover:abc-underline">como calculamos</a>
</p>
