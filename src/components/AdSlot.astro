---
import { SITE_CONFIG } from '../config/site';

interface Props {
  slotId?: string;
  label?: string;
  format?: 'horizontal' | 'editorial' | 'in-article';
}

const {
  slotId = 'editorial-slot',
  label = 'Espaço Publicitário • Parceiro Institucional',
  format = 'horizontal',
} = Astro.props;

const isEnabled = SITE_CONFIG.adsense.enabled && Boolean(SITE_CONFIG.adsense.clientId);
---

{isEnabled && (
  <aside
    class={`luxury-ad-frame luxury-ad-frame--${format}`}
    aria-label="Publicidade institucional"
    data-ad-slot={slotId}
  >
    <div class="luxury-ad-header">
      <span class="luxury-ad-tag">{label}</span>
      <button
        type="button"
        class="luxury-ad-partner-link"
        onclick="document.getElementById('parcerias-dialog')?.showModal()"
      >
        Anuncie no ABC ↗
      </button>
    </div>
    <div class="luxury-ad-canvas">
      <ins
        class="adsbygoogle"
        style="display:block; width:100%;"
        data-ad-client={SITE_CONFIG.adsense.clientId}
        data-ad-slot={slotId}
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
    </div>
  </aside>
)}

<style>
  /* Arquitetura LuxuryAd: Moldura Editorial com Reserva Estrita de Layout (Zero CLS) */
  .luxury-ad-frame {
    margin-block: 2.5rem;
    padding: 0.75rem 1.15rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    contain: layout style paint;
  }

  .luxury-ad-frame--horizontal {
    min-block-size: 124px;
  }

  .luxury-ad-frame--editorial,
  .luxury-ad-frame--in-article {
    min-block-size: 140px;
  }

  .luxury-ad-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block-end: 0.45rem;
    border-block-end: 1px solid var(--border-subtle);
  }

  .luxury-ad-tag {
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .luxury-ad-partner-link {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .luxury-ad-partner-link:hover {
    color: var(--brand-blue);
  }

  .luxury-ad-canvas {
    min-block-size: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    overflow: hidden;
  }
</style>
