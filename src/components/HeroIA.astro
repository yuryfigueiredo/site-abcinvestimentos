---
import { CALCULATORS } from '../data/calculators';
import FinanceIcon from './icons/FinanceIcon.astro';

const topFour = CALCULATORS.filter((c) => c.isTopFour);
---

<section class="hero-section" id="consultor-ia">
  <!-- Canvas de Constelação Orbital (Estilo Mais Retorno) -->
  <canvas id="hero-constellation-canvas" class="hero-canvas" aria-hidden="true"></canvas>

  <!-- Tags Flutuantes de Mercado no Espaço Cósmico -->
  <div class="ambient-tags-layer" aria-hidden="true">
    <span class="ambient-tag tag-pos-1"><span class="tag-dot"></span>Selic 14,25%</span>
    <span class="ambient-tag tag-pos-2"><span class="tag-dot"></span>MXRF11 FII</span>
    <span class="ambient-tag tag-pos-3"><span class="tag-dot"></span>CDI 14,15%</span>
    <span class="ambient-tag tag-pos-4"><span class="tag-dot"></span>Tesouro Selic</span>
    <span class="ambient-tag tag-pos-5"><span class="tag-dot"></span>IPCA 4,56%</span>
    <span class="ambient-tag tag-pos-6"><span class="tag-dot"></span>VALE3 Ação</span>
  </div>

  <div class="container hero-container">
    <!-- Headline de Alto Impacto -->
    <div class="hero-headline">
      <h1 class="hero-title">
        Pesquise, compare e simule seus investimentos na mesma plataforma
      </h1>
      <p class="hero-subtitle">
        Calculadoras gratuitas, inteligência com dados oficiais do Banco Central e sem economês.
      </p>
    </div>

    <!-- Barra de Busca / Consultor IA em Cápsula (Padrão 68px Mais Retorno) -->
    <div class="search-capsule-wrapper">
      <!-- Badge de Autoridade da IA Especialista Proprietária -->
      <div class="ia-authority-tag" aria-label="Tecnologia Especializada">
        <span class="ia-spark-lead">✨</span>
        <strong class="ia-tag-title">IA Especialista ABC</strong>
        <span class="ia-tag-sep">•</span>
        <span class="ia-tag-desc">Treinada para o investidor brasileiro com taxas do Banco Central e regras 2026</span>
      </div>

      <form id="hero-ia-form" class="search-capsule" role="search">
        <label for="hero-ia-input" class="sr-only">Digite sua dúvida ou simulação</label>
        <div class="search-icon-wrap" aria-hidden="true">
          <FinanceIcon name="search" size={22} />
        </div>
        <span class="search-divider" aria-hidden="true"></span>
        <input
          type="text"
          id="hero-ia-input"
          class="search-input"
          placeholder="Pergunte sobre CDB, FIIs, Selic ou simule..."
          maxlength="300"
          inputmode="search"
          required
        />
        <button type="submit" id="hero-ia-submit" class="search-submit-btn" aria-label="Consultar nossa IA Especialista">
          <FinanceIcon name="sparkles" size={17} />
          <span>Consultar IA Especialista</span>
        </button>
      </form>
      <label class="ia-consent-label">
        <span>Ao pesquisar, você concorda com o uso desta conversa para treinar e melhorar a IA do ABC Investimentos.</span>
        <a href="/privacidade">Saiba mais</a>
      </label>

      <!-- Chips de Teste em 1 Clique (Cápsulas de Vidro Escuro) -->
      <div class="search-chips-row">
        <span class="chips-label">Atalhos rápidos:</span>
        <button
          type="button"
          class="search-chip"
          data-ia-prompt="Vale mais a pena CDB de 105% do CDI ou LCI de 92% isenta para 1 ano?"
        >
          CDB 105% vs LCI 92%
        </button>
        <button
          type="button"
          class="search-chip"
          data-ia-prompt="Quanto preciso ter investido para receber R$ 3.000 por mês de dividendos?"
        >
          Meta R$ 3.000/mês Dividendos
        </button>
        <button
          type="button"
          class="search-chip"
          data-ia-prompt="Sou CLT com custo fixo de R$ 4.000. Onde guardar minha Reserva de Emergência?"
        >
          Reserva de Emergência Ideal
        </button>
      </div>

      <!-- Resposta Inteligente da IA ao Vivo (Estilo Google AI Overview + Continuação de Assunto) -->
      <div id="hero-ia-response" class="ia-response-modal" hidden aria-live="polite">
        <div class="ia-response-head">
          <div class="ia-response-title">
            <FinanceIcon name="bot" size={18} />
            <strong>Consultor IA • ABC Investimentos</strong>
            <span class="ia-badge-live" id="ia-badge-source">IA Especialista ABC • Análise em Tempo Real</span>
          </div>
          <button type="button" id="ia-close-btn" class="ia-close-btn" aria-label="Fechar resposta">×</button>
        </div>

        <!-- Thread da Conversa com Histórico Acumulado -->
        <div class="ia-chat-thread" id="ia-chat-thread">
          <div class="ia-response-body" id="hero-ia-answer-text"></div>
          <div class="ia-response-actions" id="hero-ia-actions"></div>
        </div>

        <!-- Caixinha Estilo Google AI para Responder em Cima e Continuar no Mesmo Assunto -->
        <div class="chat-followup-area" id="chat-followup-area">
          <form id="chat-followup-form" class="chat-followup-form">
            <div class="chat-followup-capsule">
              <span class="chat-followup-icon" aria-hidden="true">
                <FinanceIcon name="sparkles" size={17} />
              </span>
              <input
                type="text"
                id="chat-followup-input"
                class="chat-followup-input"
                placeholder="Pergunte o que quiser ou continue sobre este assunto..."
                maxlength="300"
                inputmode="search"
                autocomplete="off"
                required
              />
              <button type="submit" id="chat-followup-submit" class="chat-followup-btn" aria-label="Enviar pergunta de continuação">
                <span>Perguntar</span>
                <span class="followup-arrow" aria-hidden="true">→</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Gate / Modal de Captura de Lead na Segunda Pergunta -->
        <div class="lead-capture-overlay" id="lead-capture-overlay" hidden style="display: none;">
          <div class="lead-capture-card" role="dialog" aria-modal="true" aria-labelledby="lead-card-title">
            <button type="button" class="lead-close-btn" id="lead-close-btn" aria-label="Fechar identificação">✕</button>
            <div class="lead-card-header">
              <span class="lead-sparkle-badge">✨ Consultor Exclusivo ABC</span>
              <h3 class="lead-card-title" id="lead-card-title">Continue sua consultoria personalizada</h3>
              <p class="lead-card-desc">
                Você concluiu sua 1ª consulta gratuita! Para continuar esta conversa com nossa IA Especialista e receber o resumo das simulações, informe seu Nome e WhatsApp (ou E-mail):
              </p>
            </div>

            <form id="lead-capture-form" class="lead-card-form">
              <div class="lead-form-group">
                <label for="lead-name-input">Seu Nome Completo:</label>
                <input
                  type="text"
                  id="lead-name-input"
                  class="lead-form-input"
                  placeholder="Ex: Carlos Eduardo Silva"
                  required
                />
              </div>

              <div class="lead-form-group">
                <label for="lead-contact-input">WhatsApp com DDD ou E-mail:</label>
                <input
                  type="text"
                  id="lead-contact-input"
                  class="lead-form-input"
                  placeholder="Ex: (21) 99750-6921 ou seu@email.com"
                  required
                />
              </div>

              <button type="submit" id="lead-form-submit" class="lead-form-btn">
                <span>Liberar Consultor IA & Continuar</span>
                <span class="lead-btn-arrow">→</span>
              </button>

              <p class="lead-security-note">
                🔒 Seus dados estão 100% seguros. Não enviamos spam nem compartilhamos com terceiros.
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- "Escolha por onde começar" — Os 4 Cards Idênticos ao Mais Retorno -->
    <div class="start-section">
      <p class="start-label">Escolha por onde começar</p>

      <div class="tools-grid-4">
        {topFour.map((tool) => (
          <a href={`/calculadoras/${tool.slug}`} class="tool-card-mr" title={`Acessar ${tool.title}`}>
            <div class="tool-card-top">
              <span class="tool-card-icon-wrap">
                <FinanceIcon name={tool.icon} size={22} />
              </span>
              <span class="tool-card-badge">{tool.badge}</span>
            </div>
            <div class="tool-card-info">
              <h3 class="tool-card-title">{tool.shortTitle}</h3>
              <p class="tool-card-desc">{tool.subtitle}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Faixa de Métricas & Prova Social (Abaixo dos Cards) -->
    <div class="metrics-bar">
      <div class="metric-item">
        <strong class="metric-number">100%</strong>
        <span class="metric-label">Gratuito e sem cadastro</span>
      </div>
      <div class="metric-divider"></div>
      <div class="metric-item">
        <strong class="metric-number">BCB / SGS</strong>
        <span class="metric-label">Taxas oficiais do Banco Central</span>
      </div>
      <div class="metric-divider"></div>
      <div class="metric-item">
        <strong class="metric-number">2026</strong>
        <span class="metric-label">Tributação e regras vigentes</span>
      </div>
      <div class="metric-divider"></div>
      <div class="metric-item">
        <strong class="metric-number">6 Simuladores</strong>
        <span class="metric-label">Do zero ao 1º Milhão</span>
      </div>
    </div>
  </div>
</section>

<script>
  // 1. Script de Animação da Constelação Orbital no Canvas (Estilo Mais Retorno)
  function initConstellation() {
    const canvas = document.getElementById('hero-constellation-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let animationFrameId: number;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      alpha: number;
      pulseSpeed: number;
    }

    let particles: Particle[] = [];

    function resize() {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      width = canvas.width = rect.width * (window.devicePixelRatio || 1);
      height = canvas.height = rect.height * (window.devicePixelRatio || 1);
      createParticles();
    }

    function createParticles() {
      particles = [];
      const count = Math.floor(Math.min(50, (width * height) / 25000));
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.45,
          vy: (Math.random() - 0.5) * 0.45,
          radius: Math.random() * 1.8 + 1.2,
          alpha: Math.random() * 0.6 + 0.2,
          pulseSpeed: Math.random() * 0.02 + 0.01,
        });
      }
    }

    function draw() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      // Traços conectivos
      const maxDist = 140 * (window.devicePixelRatio || 1);
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < maxDist) {
            const lineAlpha = (1 - dist / maxDist) * 0.18;
            ctx.strokeStyle = `rgba(56, 189, 248, ${lineAlpha})`;
            ctx.lineWidth = 1 * (window.devicePixelRatio || 1);
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.stroke();
          }
        }
      }

      // Desenhar nós
      for (const p of particles) {
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius * (window.devicePixelRatio || 1), 0, Math.PI * 2);
        ctx.fillStyle = `rgba(56, 189, 248, ${p.alpha})`;
        ctx.shadowColor = 'rgba(56, 189, 248, 0.4)';
        ctx.shadowBlur = 8;
        ctx.fill();

        if (!prefersReducedMotion) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0 || p.x > width) p.vx *= -1;
          if (p.y < 0 || p.y > height) p.vy *= -1;
          p.alpha += Math.sin(Date.now() * p.pulseSpeed * 0.05) * 0.01;
        }
      }

      if (!prefersReducedMotion) {
        animationFrameId = requestAnimationFrame(draw);
      }
    }

    window.addEventListener('resize', resize);
    resize();
    draw();
  }

  initConstellation();

  import { processConsultantQuery } from '../lib/ai-assistant';

  function renderBlockLines(lines: string[]): string {
    const htmlParts: string[] = [];
    let inList = false;

    for (const rawLine of lines) {
      const line = rawLine.trim();
      if (!line) {
        if (inList) {
          htmlParts.push('</ul>');
          inList = false;
        }
        continue;
      }

      const escaped = line.replace(/[&<>"']/g, (character) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      })[character] || character);
      const formatted = escaped.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

      if (line.startsWith('- ') || line.startsWith('* ')) {
        if (!inList) {
          htmlParts.push('<ul class="ia-bullet-list">');
          inList = true;
        }
        const bulletText = formatted.replace(/^[-*]\s*/, '');
        htmlParts.push(`<li><span class="bullet-content">${bulletText}</span></li>`);
      } else if (line.startsWith('### ')) {
        if (inList) {
          htmlParts.push('</ul>');
          inList = false;
        }
        htmlParts.push(`<h4 class="ia-subheading">${formatted.replace(/^###\s*/, '')}</h4>`);
      } else if (line.startsWith('## ')) {
        if (inList) {
          htmlParts.push('</ul>');
          inList = false;
        }
        htmlParts.push(`<h3 class="ia-heading">${formatted.replace(/^##\s*/, '')}</h3>`);
      } else if (/^\d+\.\s/.test(line)) {
        if (inList) {
          htmlParts.push('</ul>');
          inList = false;
        }
        htmlParts.push(`<p class="ia-numbered-p">${formatted}</p>`);
      } else {
        if (inList) {
          htmlParts.push('</ul>');
          inList = false;
        }
        htmlParts.push(`<p>${formatted}</p>`);
      }
    }

    if (inList) {
      htmlParts.push('</ul>');
    }

    return htmlParts.join('');
  }

  function renderMarkdown(md: string): string {
    const rawLines = md.split('\n');
    interface SectionBlock {
      type: 'diagnostic' | 'simulation' | 'warning' | 'general';
      title: string;
      icon: string;
      lines: string[];
    }

    const blocks: SectionBlock[] = [];
    let currentBlock: SectionBlock = {
      type: 'general',
      title: '',
      icon: '',
      lines: []
    };

    for (const line of rawLines) {
      const trimmed = line.trim();

      // Reconhecimento resiliente dos blocos estratégicos
      const isDiag = /^(?:1\.\s*|#+\s*)?(?:DIAGNÓSTICO\s*(?:DIRETO|ESTRATÉGICO)?|DIAGNOSTICO)/i.test(trimmed);
      const isSim = /^(?:2\.\s*|#+\s*)?(?:SIMULAÇÃO\s*(?:OU\s*CÁLCULO\s*REAL)?|SIMULACAO|CÁLCULO\s*REAL|CALCULO)/i.test(trimmed);
      const isWarn = /^(?:3\.\s*|#+\s*)?(?:ATENÇÃO\s*PRÁTICA|ATENCAO\s*PRATICA|REGRAS\s*E\s*RISCOS|PONTOS\s*DE\s*ATENÇÃO)/i.test(trimmed);

      if (isDiag) {
        if (currentBlock.lines.length > 0) blocks.push(currentBlock);
        currentBlock = { type: 'diagnostic', title: 'Diagnóstico Estratégico', icon: '🎯', lines: [] };
        continue;
      } else if (isSim) {
        if (currentBlock.lines.length > 0) blocks.push(currentBlock);
        currentBlock = { type: 'simulation', title: 'Simulação & Números Reais', icon: '📊', lines: [] };
        continue;
      } else if (isWarn) {
        if (currentBlock.lines.length > 0) blocks.push(currentBlock);
        currentBlock = { type: 'warning', title: 'Atenção Prática & Regras', icon: '⚠️', lines: [] };
        continue;
      }

      currentBlock.lines.push(line);
    }

    if (currentBlock.lines.length > 0) {
      blocks.push(currentBlock);
    }

    // Se for texto geral sem os 3 tópicos, aplica formatação fluida padrão
    if (blocks.length === 1 && blocks[0].type === 'general') {
      return `<div class="ia-general-body">${renderBlockLines(blocks[0].lines)}</div>`;
    }

    return blocks
      .map((b) => {
        const content = renderBlockLines(b.lines);
        if (!content.trim()) return '';

        if (b.type === 'diagnostic') {
          return `
            <div class="ia-section-card ia-card-diagnostic">
              <div class="ia-card-badge">
                <span class="badge-icon">${b.icon}</span>
                <span>${b.title}</span>
              </div>
              <div class="ia-card-content">${content}</div>
            </div>
          `;
        }
        if (b.type === 'simulation') {
          return `
            <div class="ia-section-card ia-card-simulation">
              <div class="ia-card-badge">
                <span class="badge-icon">${b.icon}</span>
                <span>${b.title}</span>
              </div>
              <div class="ia-card-content">${content}</div>
            </div>
          `;
        }
        if (b.type === 'warning') {
          return `
            <div class="ia-section-card ia-card-warning">
              <div class="ia-card-badge">
                <span class="badge-icon">${b.icon}</span>
                <span>${b.title}</span>
              </div>
              <div class="ia-card-content">${content}</div>
            </div>
          `;
        }
        return `<div class="ia-general-body">${content}</div>`;
      })
      .join('');
  }

  // 2. Interações do Consultor IA, Thread de Conversa estilo Google e Captura de Lead
  const iaForm = document.getElementById('hero-ia-form') as HTMLFormElement | null;
  const iaInput = document.getElementById('hero-ia-input') as HTMLInputElement | null;
  const iaSubmit = document.getElementById('hero-ia-submit') as HTMLButtonElement | null;
  const iaResponse = document.getElementById('hero-ia-response');
  const iaAnswerText = document.getElementById('hero-ia-answer-text');
  const iaActions = document.getElementById('hero-ia-actions');
  const iaCloseBtn = document.getElementById('ia-close-btn');
  const iaBadgeSource = document.getElementById('ia-badge-source');
  const chatThread = document.getElementById('ia-chat-thread');

  // Elementos da Caixinha de Continuação estilo IA do Google
  const followupForm = document.getElementById('chat-followup-form') as HTMLFormElement | null;
  const followupInput = document.getElementById('chat-followup-input') as HTMLInputElement | null;
  const followupSubmit = document.getElementById('chat-followup-submit') as HTMLButtonElement | null;

  // Elementos do Modal de Captura de Lead
  const leadOverlay = document.getElementById('lead-capture-overlay');
  const leadForm = document.getElementById('lead-capture-form') as HTMLFormElement | null;
  const leadNameInput = document.getElementById('lead-name-input') as HTMLInputElement | null;
  const leadContactInput = document.getElementById('lead-contact-input') as HTMLInputElement | null;

  // Histórico de conversa mantido em memória para continuidade contextual (estilo Google AI)
  let conversationHistory: Array<{ role: 'user' | 'assistant'; content: string }> = [];
  let pendingQuestion = '';

  function escapeHtml(str: string): string {
    return str.replace(/[&<>'"]/g, (tag) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      "'": '&#39;',
      '"': '&quot;',
    }[tag] || tag));
  }

  function getQuestionCount(): number {
    try {
      return parseInt(localStorage.getItem('abc_ia_question_count') || '0', 10);
    } catch {
      return 0;
    }
  }

  function isLeadCaptured(): boolean {
    try {
      return localStorage.getItem('abc_lead_captured') === 'true';
    } catch {
      return false;
    }
  }

  function openLeadModal(questionText: string) {
    pendingQuestion = questionText;
    if (leadOverlay) {
      leadOverlay.removeAttribute('hidden');
      leadOverlay.style.display = 'flex';
      leadOverlay.hidden = false;
      leadOverlay.classList.add('is-open');
      setTimeout(() => {
        leadNameInput?.focus();
      }, 50);
    }
  }

  function closeLeadModal() {
    if (leadOverlay) {
      leadOverlay.setAttribute('hidden', '');
      leadOverlay.style.display = 'none';
      leadOverlay.hidden = true;
      leadOverlay.classList.remove('is-open');
    }
  }

  function renderCalculatorLinks(calculators: Array<{ title: string; slug: string; params?: string }>): string {
    if (!Array.isArray(calculators) || calculators.length === 0) return '';
    const linksHtml = calculators
      .map(
        (calc) => `
        <a href="/calculadoras/${calc.slug}${calc.params || ''}" class="btn-ia-action">
          <span class="btn-action-text">${calc.title}</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      `
      )
      .join('');
    return `
      <div class="ia-rec-title">Simulação Completa nas Ferramentas:</div>
      <div class="ia-rec-list">${linksHtml}</div>
    `;
  }

  async function executeQuestion(questionText: string, isFollowUp = false) {
    const q = questionText.trim();
    if (!q) return;

    // Regra do Captador de Informações na Segunda Pergunta:
    // 1ª pergunta: totalmente gratuita e sem cadastro
    // 2ª pergunta em diante: bloqueia com modal até preencher Nome e WhatsApp/E-mail
    const count = getQuestionCount();
    if (count >= 1 && !isLeadCaptured()) {
      openLeadModal(q);
      return;
    }

    if (iaSubmit) iaSubmit.disabled = true;
    if (followupSubmit) followupSubmit.disabled = true;

    if (iaResponse && iaResponse.hidden) {
      iaResponse.hidden = false;
      iaResponse.classList.add('is-open');
      requestAnimationFrame(() => {
        iaResponse.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    }

    // Registra incremento no contador de perguntas
    try {
      localStorage.setItem('abc_ia_question_count', String(count + 1));
    } catch {}

    let followupLoadingElem: HTMLElement | null = null;

    if (!isFollowUp) {
      // Primeira pergunta: reinicia histórico e exibe card de carregamento principal
      conversationHistory = [];
      if (iaAnswerText) {
        iaAnswerText.innerHTML = `
          <div class="ia-agent-loading">
            <div class="loading-header">
              <div class="loading-badge">
                <span class="loading-pulse-ring" aria-hidden="true"></span>
                <span class="loading-badge-text">Agente Especialista ABC • Análise em Tempo Real</span>
              </div>
            </div>
            <div class="loading-content">
              <p class="loading-headline">
                Nosso consultor com treinamento especializado está analisando seu cenário e buscando as melhores informações para você.
              </p>
              <p class="loading-subline">
                Cruzando taxas oficiais do <strong>Banco Central</strong> com as diretrizes fiscais de <strong>2026</strong>...
              </p>
            </div>
            <div class="loading-steps">
              <div class="loading-step step-done">
                <span class="step-icon">✓</span>
                <span class="step-text">Taxas BCB (Selic, CDI, IPCA)</span>
              </div>
              <div class="loading-step step-pulse">
                <span class="step-spinner" aria-hidden="true"></span>
                <span class="step-text">Processando Inteligência em Nuvem</span>
              </div>
              <div class="loading-step step-pending">
                <span class="step-icon">○</span>
                <span class="step-text">Estruturando Estratégia & Simulação</span>
              </div>
            </div>
            <div class="loading-progress-wrap">
              <progress class="ia-loading-progress" aria-label="Processando análise patrimonial"></progress>
            </div>
          </div>
        `;
      }
      if (iaActions) iaActions.innerHTML = '';
    } else {
      // Pergunta de continuação: adiciona bolha do usuário e bolha de loading na thread
      if (chatThread) {
        const userBubble = document.createElement('div');
        userBubble.className = 'chat-turn-user';
        userBubble.innerHTML = `
          <span class="user-turn-badge">Sua Pergunta de Continuação:</span>
          <div class="user-turn-text">${escapeHtml(q)}</div>
        `;
        chatThread.appendChild(userBubble);

        followupLoadingElem = document.createElement('div');
        followupLoadingElem.className = 'chat-turn-loading';
        followupLoadingElem.innerHTML = `
          <div class="step-spinner" aria-hidden="true"></div>
          <span>Analisando continuidade da dúvida mantendo o mesmo assunto...</span>
        `;
        chatThread.appendChild(followupLoadingElem);

        requestAnimationFrame(() => {
          followupLoadingElem?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
      }
    }

    try {
      const indicators = (window as any).__ABC_INDICATORS__ || undefined;
      const [data] = await Promise.all([
        processConsultantQuery(q, indicators, {
          conversationConsent: true,
          history: conversationHistory,
        }),
        new Promise((resolve) => setTimeout(resolve, 320)),
      ]);

      if (iaBadgeSource) {
        if (data.source === 'cloudflare-ai') {
          iaBadgeSource.className = 'ia-badge-live';
          iaBadgeSource.textContent = 'IA Especialista ABC • Cloudflare Ultra-Rápida';
        } else if (data.source === 'groq-llama') {
          iaBadgeSource.className = 'ia-badge-live';
          iaBadgeSource.textContent = 'IA Especialista ABC • Alta Velocidade Groq';
        } else if (data.source === 'gemini-3.5-flash' || data.source === 'gemini-flash' || data.source === 'gemini-1.5-flash') {
          iaBadgeSource.className = 'ia-badge-live';
          iaBadgeSource.textContent = 'IA Especialista ABC • Análise em Tempo Real';
        } else if (data.source === 'openrouter-free') {
          iaBadgeSource.className = 'ia-badge-live';
          iaBadgeSource.textContent = 'IA Especialista ABC • Modelo de Reserva';
        } else {
          iaBadgeSource.className = 'ia-badge-live ia-badge-local';
          iaBadgeSource.textContent = 'Motor Heurístico ABC • Auditoria Local';
        }
      }

      // Adiciona ao histórico conversacional para próximas perguntas
      conversationHistory.push({ role: 'user', content: q });
      conversationHistory.push({ role: 'assistant', content: data.answer });

      if (!isFollowUp) {
        if (iaAnswerText) iaAnswerText.innerHTML = renderMarkdown(data.answer);
        if (iaActions) iaActions.innerHTML = renderCalculatorLinks(data.recommendedCalculators);
      } else {
        if (followupLoadingElem && followupLoadingElem.parentNode) {
          followupLoadingElem.parentNode.removeChild(followupLoadingElem);
        }
        if (chatThread) {
          const assistantTurn = document.createElement('div');
          assistantTurn.className = 'chat-turn-assistant';
          assistantTurn.innerHTML = `
            <div class="assistant-turn-head">
              <span class="ia-spark-lead">✨</span>
              <strong>Consultor IA Especialista</strong>
            </div>
            <div class="assistant-turn-body">${renderMarkdown(data.answer)}</div>
          `;
          chatThread.appendChild(assistantTurn);

          if (iaActions) {
            iaActions.innerHTML = renderCalculatorLinks(data.recommendedCalculators);
            chatThread.appendChild(iaActions);
          }
        }
      }

      if (iaInput) iaInput.value = '';
      if (followupInput) followupInput.value = '';

      requestAnimationFrame(() => {
        const area = document.getElementById('chat-followup-area');
        if (area) area.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    } catch {
      if (followupLoadingElem && followupLoadingElem.parentNode) {
        followupLoadingElem.parentNode.removeChild(followupLoadingElem);
      }
      if (!isFollowUp) {
        if (iaAnswerText) {
          iaAnswerText.innerHTML = `<p>Para esta comparação, acesse diretamente nossos simuladores gratuitos:</p>`;
        }
      }
      if (iaActions) {
        iaActions.innerHTML = `
          <div class="ia-rec-title">Acesse diretamente os simuladores gratuitos:</div>
          <div class="ia-rec-list">
            <a href="/calculadoras/renda-fixa" class="btn-ia-action">
              <span class="btn-action-text">Simulador Renda Fixa (CDB vs LCI)</span>
              <span class="btn-arrow">→</span>
            </a>
            <a href="/calculadoras/juros-compostos" class="btn-ia-action">
              <span class="btn-action-text">Juros Compostos & 1º Milhão</span>
              <span class="btn-arrow">→</span>
            </a>
          </div>
        `;
      }
    } finally {
      if (iaSubmit) iaSubmit.disabled = false;
      if (followupSubmit) followupSubmit.disabled = false;
    }
  }

  // 1. Envio do Formulário Principal do Hero
  if (iaForm && iaInput) {
    iaForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const question = iaInput.value.trim();
      if (!question) return;
      const isFollowUp = conversationHistory.length > 0 && iaResponse && !iaResponse.hidden;
      executeQuestion(question, isFollowUp);
    });
  }

  // 2. Envio da Caixinha de Continuação estilo Google
  if (followupForm && followupInput) {
    followupForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const question = followupInput.value.trim();
      if (!question) return;
      executeQuestion(question, true);
    });
  }

  // 3. Submissão do Modal de Captura de Lead
  if (leadForm && leadOverlay && leadNameInput && leadContactInput) {
    leadForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = leadNameInput.value.trim();
      const contact = leadContactInput.value.trim();
      if (!name || !contact) return;

      try {
        localStorage.setItem('abc_lead_captured', 'true');
        localStorage.setItem('abc_lead_data', JSON.stringify({ name, contact, date: new Date().toISOString() }));
      } catch {}

      const submitBtn = document.getElementById('lead-form-submit') as HTMLButtonElement | null;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Liberando Consultor...';
      }

      // Grava no servidor de forma assíncrona sem travar a navegação
      fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, contact, question: pendingQuestion }),
      }).catch(() => {});

      // Fecha o modal IMEDIATAMENTE
      closeLeadModal();

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<span>Liberar Consultor IA & Continuar</span><span class="lead-btn-arrow">→</span>';
      }

      // Desbloqueia e executa a pergunta pendente na mesma hora sem o usuário ter que redigitar
      const questionToRun = pendingQuestion || followupInput?.value?.trim() || iaInput?.value?.trim() || '';
      pendingQuestion = '';
      if (questionToRun) {
        executeQuestion(questionToRun, true);
      }
    });
  }

  // Fechamento pelo botão "✕" do modal de identificação
  const leadCloseBtn = document.getElementById('lead-close-btn');
  if (leadCloseBtn) {
    leadCloseBtn.addEventListener('click', () => {
      closeLeadModal();
    });
  }

  // Fechar ao clicar fora do card (no backdrop)
  if (leadOverlay) {
    leadOverlay.addEventListener('click', (e) => {
      if (e.target === leadOverlay) {
        closeLeadModal();
      }
    });
  }

  // Fechamento e light-dismiss do Modal de Resposta
  if (iaCloseBtn && iaResponse) {
    iaCloseBtn.addEventListener('click', () => {
      iaResponse.classList.remove('is-open');
      iaResponse.hidden = true;
    });
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (leadOverlay && !leadOverlay.hidden && leadOverlay.style.display !== 'none') {
        closeLeadModal();
        pendingQuestion = '';
        return;
      }
      if (iaResponse && !iaResponse.hidden) {
        iaResponse.classList.remove('is-open');
        iaResponse.hidden = true;
      }
    }
  });

  document.addEventListener('click', (e) => {
    if (iaResponse && !iaResponse.hidden) {
      const target = e.target as HTMLElement;
      if (!iaResponse.contains(target) && !iaForm?.contains(target) && !target.closest('.search-chip')) {
        iaResponse.classList.remove('is-open');
        iaResponse.hidden = true;
      }
    }
  });

  // Atalhos rápidos dos Chips
  document.querySelectorAll<HTMLButtonElement>('.search-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const prompt = chip.dataset.iaPrompt;
      if (prompt && iaInput) {
        iaInput.value = prompt;
        iaForm?.requestSubmit();
      }
    });
  });
</script>

