  /* Caixinha Estilo IA do Google (Follow-up Input) */
  .chat-followup-area {
    margin-top: 1.5rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--border-subtle);
    width: 100%;
  }

  .chat-followup-form {
    width: 100%;
  }

  .chat-followup-capsule {
    display: flex;
    align-items: center;
    background: var(--bg-surface);
    border: 1.5px solid var(--border-card);
    border-radius: 9999px;
    height: 52px;
    padding: 0.25rem 0.35rem 0.25rem 1.15rem;
    box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.25);
    transition: all 0.2s ease;
    width: 100%;
  }

  :root[data-theme="light"] .chat-followup-capsule,
  html[data-theme="light"] .chat-followup-capsule {
    background: #f8fafc;
    border-color: #cbd5e1;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
