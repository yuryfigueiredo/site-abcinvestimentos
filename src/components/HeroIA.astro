    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .chat-followup-btn:hover {
    background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(56, 189, 248, 0.4);
  }

  .followup-arrow {
    font-size: 1rem;
    font-weight: 700;
  }

  /* Overlay de Captura de Lead na Segunda Pergunta */
  .lead-capture-overlay {
    position: absolute;
    inset: 0;
    background: rgba(10, 15, 29, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-radius: 18px;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    animation: leadOverlayFade 0.25s ease forwards;
  }

  .lead-capture-overlay[hidden] {
    display: none !important;
  }

  @keyframes leadOverlayFade {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  :root[data-theme="light"] .lead-capture-overlay,
  html[data-theme="light"] .lead-capture-overlay {
    background: rgba(248, 250, 252, 0.92);
  }

  .lead-capture-card {
    position: relative;
    background: var(--bg-surface);
    border: 1.5px solid rgba(56, 189, 248, 0.35);
    border-radius: 16px;
