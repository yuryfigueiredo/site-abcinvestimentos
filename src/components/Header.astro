---
import { CALCULATORS } from '../data/calculators';
import FinanceIcon from './icons/FinanceIcon.astro';

const pathname = Astro.url.pathname;
const isCalcActive = pathname.startsWith('/calculadoras');
const isGuiaActive = pathname.startsWith('/guia');
const isPlanilhaActive = pathname.startsWith('/planilha-abc');
---

<div class="sticky-container">
  <header class="sticky-header">
    <div class="container header-inner">
      <a href="/" class="brand-logo" aria-label="ABC Investimentos — Página Inicial">
        <span class="brand-mark" aria-hidden="true">ABC</span>
        <span class="brand-title">INVESTIMENTOS</span>
      </a>

      <nav class="main-nav" aria-label="Navegação principal">
        <div class="nav-dropdown-wrap">
          <button
            type="button"
            class:list={['nav-link', 'dropdown-trigger', { 'is-active': isCalcActive }]}
            aria-expanded="false"
            id="calc-menu-btn"
          >
            <span>Ferramentas</span>
            <svg class="caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="mega-dropdown" id="calc-mega-menu" role="region" aria-label="Menu de Calculadoras Financeiras">
            <div class="mega-header">
              <strong>Simuladores & Calculadoras</strong>
              <span>100% gratuitos • Dados Banco Central</span>
            </div>
            <div class="mega-grid">
              {CALCULATORS.map((calc) => (
                <a href={`/calculadoras/${calc.slug}`} class="mega-item">
                  <span class="mega-icon" aria-hidden="true">
                    <FinanceIcon name={calc.icon} size={18} />
                  </span>
                  <div>
                    <div class="mega-item-title">
                      <span>{calc.shortTitle}</span>
                      <span class="mega-badge">{calc.badge}</span>
                    </div>
                    <p>{calc.subtitle}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>

        <a href="/guia" class:list={['nav-link', { 'is-active': isGuiaActive }]} aria-current={isGuiaActive ? 'page' : undefined}>
          Guia ABC
        </a>
        <a href="/#consultor-ia" class="nav-link">Consultor IA</a>
        <a href="/planilha-abc" class:list={['nav-link', { 'is-active': isPlanilhaActive }]} aria-current={isPlanilhaActive ? 'page' : undefined}>
          Planilha 50/30/20
        </a>
      </nav>

      <div class="header-actions">
        <button
          type="button"
          class="theme-toggle-btn"
          id="theme-toggle-btn"
          aria-label="Alternar tema claro ou escuro"
          title="Alternar tema claro ou escuro"
        >
          <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2m-7.07-14.93 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2m-15.66 5.66-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>

        <a href="/planilha-abc" class="header-cta-btn">
          Planilha ABC PRO →
        </a>

        <!-- Botão Menu Mobile (Hamburguer acessível) -->
        <button
          type="button"
          class="mobile-menu-btn"
          id="mobile-menu-btn"
          aria-expanded="false"
          aria-controls="mobile-drawer"
          aria-label="Abrir menu de navegação"
        >
          <span class="mobile-menu-icon" aria-hidden="true">
            <span class="bar bar-1"></span>
            <span class="bar bar-2"></span>
            <span class="bar bar-3"></span>
          </span>
        </button>
      </div>
    </div>
  </header>

  <!-- Gaveta de Navegação Mobile (Mobile Drawer) -->
  <div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop" hidden></div>
  <aside class="mobile-drawer" id="mobile-drawer" role="dialog" aria-modal="true" aria-label="Menu Principal" hidden>
    <div class="mobile-drawer-content">
      <div class="mobile-drawer-header">
        <div class="mobile-drawer-brand">
          <span class="brand-mark">ABC</span>
          <span class="brand-title">INVESTIMENTOS</span>
        </div>
        <button type="button" class="mobile-drawer-close" id="mobile-drawer-close" aria-label="Fechar menu">
          ✕
        </button>
      </div>

      <div class="mobile-drawer-scroll">
        <div class="mobile-drawer-section">
          <span class="mobile-section-heading">Simuladores & Calculadoras</span>
          <div class="mobile-calcs-grid">
            {CALCULATORS.map((calc) => (
              <a href={`/calculadoras/${calc.slug}`} class="mobile-calc-item">
                <span class="mobile-calc-icon" aria-hidden="true">
                  <FinanceIcon name={calc.icon} size={18} />
                </span>
                <div class="mobile-calc-info">
                  <strong class="mobile-calc-name">{calc.shortTitle}</strong>
                  <span class="mobile-calc-sub">{calc.subtitle}</span>
                </div>
                <span class="mobile-calc-arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>

        <div class="mobile-drawer-section">
          <span class="mobile-section-heading">Conteúdo & Ferramentas</span>
          <div class="mobile-nav-links">
            <a href="/guia" class="mobile-nav-row">
              <span>📖 Guia ABC & Dicionário A–Z</span>
              <span class="mobile-arrow">→</span>
            </a>
            <a href="/#consultor-ia" class="mobile-nav-row" id="mobile-drawer-ia-link">
              <span>✨ Consultor IA Especialista</span>
              <span class="mobile-arrow">→</span>
            </a>
            <a href="/planilha-abc" class="mobile-nav-row mobile-nav-row--highlight">
              <span>📊 Planilha ABC 50/30/20 (R$ 29,90)</span>
              <span class="mobile-badge-new">PRO</span>
            </a>
          </div>
        </div>

        <div class="mobile-drawer-footer">
          <a href="/planilha-abc" class="btn btn-primary mobile-cta-full">
            Garantir Planilha Oficial por R$ 29,90 →
          </a>
        </div>
      </div>
    </div>
  </aside>
</div>

<script>
  const menuBtn = document.getElementById('calc-menu-btn');
  const megaMenu = document.getElementById('calc-mega-menu');

  if (menuBtn && megaMenu) {
    menuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const expanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!expanded));
      megaMenu.classList.toggle('is-open', !expanded);
    });

    document.addEventListener('click', (e) => {
      if (!megaMenu.contains(e.target as Node) && e.target !== menuBtn) {
        menuBtn.setAttribute('aria-expanded', 'false');
        megaMenu.classList.remove('is-open');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        menuBtn.setAttribute('aria-expanded', 'false');
        megaMenu.classList.remove('is-open');
      }
    });
  }

  const themeBtn = document.getElementById('theme-toggle-btn');
  const metaScheme = document.querySelector('meta[name="color-scheme"]') as HTMLMetaElement | null;

  function getSystemScheme(): 'dark' | 'light' {
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function getRenderedScheme(): 'dark' | 'light' {
    try {
      const stored = localStorage.getItem('color-scheme');
      if (stored === 'dark' || stored === 'light') return stored;
    } catch {}
    return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
  }

  if (themeBtn && metaScheme) {
    themeBtn.addEventListener('click', () => {
      const currentRendered = getRenderedScheme();
      const target = currentRendered === 'dark' ? 'light' : 'dark';

      try {
        localStorage.setItem('color-scheme', target);
      } catch {}
      metaScheme.content = target;
      document.documentElement.dataset.theme = target;
    });

    window.addEventListener('storage', (e) => {
      if (e.key === 'color-scheme' && metaScheme) {
        const next = e.newValue === 'light' ? 'light' : 'dark';
        metaScheme.content = next;
        document.documentElement.dataset.theme = next;
      }
    });
  }

  // Controle da Gaveta de Navegação Mobile
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const mobileDrawerBackdrop = document.getElementById('mobile-drawer-backdrop');
  const mobileDrawerClose = document.getElementById('mobile-drawer-close');

  function openMobileDrawer() {
    if (!mobileDrawer || !mobileDrawerBackdrop || !mobileMenuBtn) return;
    mobileDrawer.hidden = false;
    mobileDrawerBackdrop.hidden = false;
    document.body.style.overflow = 'hidden';
    mobileMenuBtn.setAttribute('aria-expanded', 'true');
    requestAnimationFrame(() => {
      mobileDrawer.classList.add('is-open');
      mobileDrawerBackdrop.classList.add('is-open');
    });
  }

  function closeMobileDrawer() {
    if (!mobileDrawer || !mobileDrawerBackdrop || !mobileMenuBtn) return;
    mobileDrawer.classList.remove('is-open');
    mobileDrawerBackdrop.classList.remove('is-open');
    mobileMenuBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setTimeout(() => {
      mobileDrawer.hidden = true;
      mobileDrawerBackdrop.hidden = true;
    }, 280);
  }

  if (mobileMenuBtn && mobileDrawer) {
    mobileMenuBtn.addEventListener('click', () => {
      const isOpen = mobileDrawer.classList.contains('is-open');
      if (isOpen) closeMobileDrawer();
      else openMobileDrawer();
    });

    if (mobileDrawerClose) mobileDrawerClose.addEventListener('click', closeMobileDrawer);
    if (mobileDrawerBackdrop) mobileDrawerBackdrop.addEventListener('click', closeMobileDrawer);

    mobileDrawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMobileDrawer);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileDrawer.classList.contains('is-open')) {
        closeMobileDrawer();
      }
    });
  }
</script>

<style>
  .sticky-container {
    position: sticky;
    top: 0;
    z-index: 100;
    /* MANDATORY: Always specify a container name to avoid collisions if CQs are nested (state-aware-sticky-headers guide) */
    container-type: scroll-state;
    container-name: abc-header;
  }

  .sticky-header {
    background: var(--header-bg);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  /* Native CSS Container Scroll-State Query */
  @container abc-header scroll-state(stuck: top) {
    .sticky-header {
      background: var(--header-stuck-bg);
      border-bottom-color: var(--border-card);
      box-shadow: var(--card-shadow);
    }
  }

  /* Robust Progressive Fallback for browsers without scroll-state support */
  .sticky-container.is-stuck .sticky-header {
    background: var(--header-stuck-bg);
    border-bottom-color: var(--border-card);
    box-shadow: var(--card-shadow);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 1.5rem;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .brand-mark {
    background: #0284c7;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    padding: 0.22rem 0.48rem;
    border-radius: 6px;
  }

  .brand-title {
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-link {
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 500;
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem 0;
    position: relative;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--text-primary);
  }

  .nav-link.is-active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--brand-blue);
  }

  .caret {
    transition: transform 0.2s ease;
    opacity: 0.7;
  }

  .nav-dropdown-wrap {
    position: relative;
  }

  .dropdown-trigger[aria-expanded="true"] .caret {
    transform: rotate(180deg);
  }

  .mega-dropdown {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    width: 580px;
    background: var(--bg-surface);
    border: 1px solid var(--border-card);
    border-radius: 12px;
    box-shadow: var(--card-shadow);
    padding: 1.2rem;
    display: none;
    opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
  }

  .mega-dropdown.is-open {
    display: block;
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .mega-header {
    padding-bottom: 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .mega-header strong {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .mega-header span {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .mega-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .mega-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.65rem;
    border-radius: 8px;
    transition: background 0.15s ease;
  }

  .mega-item:hover {
    background: var(--pill-bg);
  }

  .mega-icon {
    color: var(--brand-blue);
    margin-top: 0.1rem;
    flex-shrink: 0;
  }

  .mega-item-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .mega-badge {
    font-size: 0.64rem;
    font-weight: 500;
    background: var(--pill-bg);
    color: var(--pill-text);
    border: 1px solid var(--pill-border);
    padding: 0.08rem 0.38rem;
    border-radius: 4px;
  }

  .mega-item p {
    font-size: 0.74rem;
    color: var(--text-secondary);
    margin-top: 0.15rem;
    line-height: 1.35;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .theme-toggle-btn {
    background: var(--pill-bg);
    border: 1px solid var(--pill-border);
    color: var(--text-secondary);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, scale 0.15s ease;
  }

  .theme-toggle-btn:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
    scale: 1.06;
  }

  .theme-toggle-btn:active {
    scale: 0.94;
  }

  .theme-icon-sun,
  .theme-icon-moon {
    display: none;
  }

  :root:has(> head > meta[name="color-scheme"][content="light"]) .theme-icon-moon,
  :root[data-theme="light"] .theme-icon-moon {
    display: block;
  }

  :root:has(> head > meta[name="color-scheme"][content="dark"]) .theme-icon-sun,
  :root[data-theme="dark"] .theme-icon-sun {
    display: block;
  }

  .header-cta-btn {
    background: var(--pill-bg);
    border: 1px solid var(--pill-border);
    color: var(--text-primary);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.45rem 0.95rem;
    border-radius: 9999px;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, scale 0.15s ease, box-shadow 0.2s ease;
  }

  .header-cta-btn:hover {
    background: #0284c7;
    border-color: #0284c7;
    color: #ffffff;
    scale: 1.025;
    box-shadow: 0 2px 10px rgba(2, 132, 199, 0.28);
  }

  .header-cta-btn:active {
    scale: 0.975;
  }

  /* Botão Hamburguer Mobile */
  .mobile-menu-btn {
    display: none;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    background: var(--pill-bg);
    border: 1px solid var(--border-card);
    border-radius: 8px;
    color: var(--text-primary);
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .mobile-menu-icon {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 18px;
    height: 13px;
  }

  .mobile-menu-icon .bar {
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.22s ease, opacity 0.22s ease;
  }

  .mobile-menu-btn[aria-expanded="true"] .bar-1 {
    transform: translateY(5.5px) rotate(45deg);
  }
  .mobile-menu-btn[aria-expanded="true"] .bar-2 {
    opacity: 0;
  }
  .mobile-menu-btn[aria-expanded="true"] .bar-3 {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  @media (max-width: 860px) {
    .main-nav {
      display: none;
    }
    .mobile-menu-btn {
      display: flex;
    }
    .header-cta-btn {
      display: none;
    }
  }

  /* Backdrop & Gaveta Lateral */
  .mobile-drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(4, 7, 15, 0.72);
    backdrop-filter: blur(4px);
    z-index: 998;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .mobile-drawer-backdrop.is-open {
    opacity: 1;
  }

  .mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(380px, 88vw);
    background: var(--bg-surface);
    border-left: 1px solid var(--border-card);
    box-shadow: -10px 0 35px rgba(0, 0, 0, 0.5);
    z-index: 999;
    transform: translateX(100%);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }

  .mobile-drawer.is-open {
    transform: translateX(0);
  }

  .mobile-drawer-content {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .mobile-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.15rem 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .mobile-drawer-brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .mobile-drawer-close {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--pill-bg);
    border: 1px solid var(--border-card);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    cursor: pointer;
  }

  .mobile-drawer-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    -webkit-overflow-scrolling: touch;
  }

  .mobile-section-heading {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .mobile-calcs-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-calc-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 0.85rem;
    border-radius: 10px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .mobile-calc-item:active {
    background: rgba(14, 165, 233, 0.12);
    border-color: var(--brand-blue);
  }

  .mobile-calc-icon {
    color: var(--brand-blue);
    flex-shrink: 0;
    display: flex;
  }

  .mobile-calc-info {
    flex: 1;
    min-width: 0;
  }

  .mobile-calc-name {
    display: block;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .mobile-calc-sub {
    display: block;
    font-size: 0.75rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mobile-calc-arrow {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: none;
    min-height: 48px;
  }

  .mobile-nav-row--highlight {
    background: rgba(14, 165, 233, 0.08);
    border-color: rgba(56, 189, 248, 0.3);
  }

  .mobile-badge-new {
    font-size: 0.65rem;
    font-weight: 700;
    background: #0284c7;
    color: #ffffff;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }

  .mobile-drawer-footer {
    margin-top: auto;
    padding-top: 1rem;
  }

  .mobile-cta-full {
    width: 100%;
    min-height: 48px;
    font-size: 0.95rem;
    font-weight: 600;
  }
</style>
