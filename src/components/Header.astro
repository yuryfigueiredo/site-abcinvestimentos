---
import { CALCULATORS } from '../data/calculators';
import FinanceIcon from './icons/FinanceIcon.astro';

const pathname = Astro.url.pathname;
const isCalcActive = pathname.startsWith('/calculadoras');
const isGuiaActive = pathname.startsWith('/guia');
const isPlanilhaActive = pathname.startsWith('/planilha-abc');
---

<div class="sticky-container">
  <header class="sticky-header">
    <div class="container header-inner">
      <a href="/" class="brand-logo" aria-label="ABC Investimentos — Página Inicial">
        <span class="brand-mark" aria-hidden="true">ABC</span>
        <span class="brand-title">INVESTIMENTOS</span>
      </a>

      <nav class="main-nav" aria-label="Navegação principal">
        <div class="nav-dropdown-wrap">
          <button
            type="button"
            class:list={['nav-link', 'dropdown-trigger', { 'is-active': isCalcActive }]}
            aria-expanded="false"
            id="calc-menu-btn"
          >
            <span>Ferramentas</span>
            <svg class="caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="mega-dropdown" id="calc-mega-menu" role="region" aria-label="Menu de Calculadoras Financeiras">
            <div class="mega-header">
              <strong>Simuladores & Calculadoras</strong>
              <span>100% gratuitos • Dados Banco Central</span>
            </div>
            <div class="mega-grid">
              {CALCULATORS.map((calc) => (
                <a href={`/calculadoras/${calc.slug}`} class="mega-item">
                  <span class="mega-icon" aria-hidden="true">
                    <FinanceIcon name={calc.icon} size={18} />
                  </span>
                  <div>
                    <div class="mega-item-title">
                      <span>{calc.shortTitle}</span>
                      <span class="mega-badge">{calc.badge}</span>
                    </div>
                    <p>{calc.subtitle}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>

        <a href="/guia" class:list={['nav-link', { 'is-active': isGuiaActive }]} aria-current={isGuiaActive ? 'page' : undefined}>
          Guia ABC
        </a>
        <a href="/#consultor-ia" class="nav-link">Consultor IA</a>
        <a href="/planilha-abc" class:list={['nav-link', { 'is-active': isPlanilhaActive }]} aria-current={isPlanilhaActive ? 'page' : undefined}>
          Planilha 50/30/20
        </a>
      </nav>

      <div class="header-actions">
        <button
          type="button"
          class="theme-toggle-btn"
          id="theme-toggle-btn"
          aria-label="Alternar tema claro ou escuro"
          title="Alternar tema claro ou escuro"
        >
          <svg class="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2m-7.07-14.93 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2m-15.66 5.66-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <svg class="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>

        <a href="/planilha-abc" class="header-cta-btn">
          Planilha ABC PRO →
        </a>
      </div>
    </div>
  </header>
</div>

<script>
  const menuBtn = document.getElementById('calc-menu-btn');
  const megaMenu = document.getElementById('calc-mega-menu');

  if (menuBtn && megaMenu) {
    menuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const expanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!expanded));
      megaMenu.classList.toggle('is-open', !expanded);
    });

    document.addEventListener('click', (e) => {
      if (!megaMenu.contains(e.target as Node) && e.target !== menuBtn) {
        menuBtn.setAttribute('aria-expanded', 'false');
        megaMenu.classList.remove('is-open');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        menuBtn.setAttribute('aria-expanded', 'false');
        megaMenu.classList.remove('is-open');
      }
    });
  }

  const themeBtn = document.getElementById('theme-toggle-btn');
  const metaScheme = document.querySelector('meta[name="color-scheme"]') as HTMLMetaElement | null;

  function getSystemScheme(): 'dark' | 'light' {
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function getRenderedScheme(): 'dark' | 'light' {
    try {
      const stored = localStorage.getItem('color-scheme');
      if (stored === 'dark' || stored === 'light') return stored;
    } catch {}
    return document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
  }

  if (themeBtn && metaScheme) {
    themeBtn.addEventListener('click', () => {
      const currentRendered = getRenderedScheme();
      const target = currentRendered === 'dark' ? 'light' : 'dark';

      try {
        localStorage.setItem('color-scheme', target);
      } catch {}
      metaScheme.content = target;
      document.documentElement.dataset.theme = target;
    });

    window.addEventListener('storage', (e) => {
      if (e.key === 'color-scheme' && metaScheme) {
        const next = e.newValue === 'light' ? 'light' : 'dark';
        metaScheme.content = next;
        document.documentElement.dataset.theme = next;
      }
    });
  }
</script>

<style>
  .sticky-container {
    position: sticky;
    top: 0;
    z-index: 100;
    /* MANDATORY: Always specify a container name to avoid collisions if CQs are nested (state-aware-sticky-headers guide) */
    container-type: scroll-state;
    container-name: abc-header;
  }

  .sticky-header {
    background: var(--header-bg);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
    transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  /* Native CSS Container Scroll-State Query */
  @container abc-header scroll-state(stuck: top) {
    .sticky-header {
      background: var(--header-stuck-bg);
      border-bottom-color: var(--border-card);
      box-shadow: var(--card-shadow);
    }
  }

  /* Robust Progressive Fallback for browsers without scroll-state support */
  .sticky-container.is-stuck .sticky-header {
    background: var(--header-stuck-bg);
    border-bottom-color: var(--border-card);
    box-shadow: var(--card-shadow);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 1.5rem;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .brand-mark {
    background: #0284c7;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    padding: 0.22rem 0.48rem;
    border-radius: 6px;
  }

  .brand-title {
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-link {
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 500;
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem 0;
    position: relative;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--text-primary);
  }

  .nav-link.is-active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--brand-blue);
  }

  .caret {
    transition: transform 0.2s ease;
    opacity: 0.7;
  }

  .nav-dropdown-wrap {
    position: relative;
  }

  .dropdown-trigger[aria-expanded="true"] .caret {
    transform: rotate(180deg);
  }

  .mega-dropdown {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    width: 580px;
    background: var(--bg-surface);
    border: 1px solid var(--border-card);
    border-radius: 12px;
    box-shadow: var(--card-shadow);
    padding: 1.2rem;
    display: none;
    opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
  }

  .mega-dropdown.is-open {
    display: block;
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .mega-header {
    padding-bottom: 0.75rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .mega-header strong {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .mega-header span {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .mega-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .mega-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.65rem;
    border-radius: 8px;
    transition: background 0.15s ease;
  }

  .mega-item:hover {
    background: var(--pill-bg);
  }

  .mega-icon {
    color: var(--brand-blue);
    margin-top: 0.1rem;
    flex-shrink: 0;
  }

  .mega-item-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .mega-badge {
    font-size: 0.64rem;
    font-weight: 500;
    background: var(--pill-bg);
    color: var(--pill-text);
    border: 1px solid var(--pill-border);
    padding: 0.08rem 0.38rem;
    border-radius: 4px;
  }

  .mega-item p {
    font-size: 0.74rem;
    color: var(--text-secondary);
    margin-top: 0.15rem;
    line-height: 1.35;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .theme-toggle-btn {
    background: var(--pill-bg);
    border: 1px solid var(--pill-border);
    color: var(--text-secondary);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, scale 0.15s ease;
  }

  .theme-toggle-btn:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
    scale: 1.06;
  }

  .theme-toggle-btn:active {
    scale: 0.94;
  }

  .theme-icon-sun,
  .theme-icon-moon {
    display: none;
  }

  :root:has(> head > meta[name="color-scheme"][content="light"]) .theme-icon-moon,
  :root[data-theme="light"] .theme-icon-moon {
    display: block;
  }

  :root:has(> head > meta[name="color-scheme"][content="dark"]) .theme-icon-sun,
  :root[data-theme="dark"] .theme-icon-sun {
    display: block;
  }

  .header-cta-btn {
    background: var(--pill-bg);
    border: 1px solid var(--pill-border);
    color: var(--text-primary);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.45rem 0.95rem;
    border-radius: 9999px;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, scale 0.15s ease, box-shadow 0.2s ease;
  }

  .header-cta-btn:hover {
    background: #0284c7;
    border-color: #0284c7;
    color: #ffffff;
    scale: 1.025;
    box-shadow: 0 2px 10px rgba(2, 132, 199, 0.28);
  }

  .header-cta-btn:active {
    scale: 0.975;
  }

  @media (max-width: 860px) {
    .main-nav {
      display: none;
    }
  }
</style>
