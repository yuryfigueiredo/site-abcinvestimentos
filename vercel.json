{
  "crons": [
    {
      "path": "/api/cron/indicadores",
      "schedule": "30 17 * * *"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/consulta",
      "destination": "/api/ia"
    }
  ],
  "redirects": [
    {
      "source": "/guia/como-viver-de-renda-Com-fiis-e-dividendos",
      "destination": "/guia/como-viver-de-renda-com-fiis-e-dividendos",
      "permanent": true
    },
    {
      "source": "/guia/como-viver-de-renda-Com-fiis-e-dividendos/",
      "destination": "/guia/como-viver-de-renda-com-fiis-e-dividendos/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/(.*)/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/api/diario/edicao.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
